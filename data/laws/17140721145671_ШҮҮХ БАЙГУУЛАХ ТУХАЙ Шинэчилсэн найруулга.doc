px} a { text-decoration: none;}  ul {padding: 0;list-style: none;} .nom-title {font-size: 11px;line-height: 22px;text-align: center;text-transform: uppercase;color: #2E3B52;max-height: 28px;overflow: hidden;margin-top: 21px;} .nom-header-top .title {font-weight: bold;font-size: 14px;line-height: 22px;color: #2E3B52;text-transform: uppercase;margin-bottom: 0;text-align: center;}.nom-header-top span {font-weight: 700;font-size: 11px;line-height: 22px;color: #000000;}.nom-header-top span {font-weight: 700;font-size: 11px;line-height: 22px;color: #000000;}.nom-more-content .uk-accordion-title {font-weight: 700;font-size: 11px;line-height: 14px;color: #2E3B52;}.nom-more-content .uk-accordion-content p {font-size: 11px;line-height: 22px;color: rgba(46, 59, 82, 0.8);margin-bottom: 0;}.nom-bottom-author {max-width: 545px;margin-left: auto;margin-top: 70px;}.nom-bottom-author h6 {font-weight: 700;font-size: 14px;line-height: 22px;color: #000000;}.uk-flex-between {justify-content: space-between;}.uk-text-center {text-align: center;}.uk-flex {display: flex;}section, p {line-height: 22px;font-size: 14px !important;font-family: Arial, Helvetica, sans-serif !important;}.pull-left {float:left;}.w-100 {width: 100%;}.w-50 {width: 50%;}</style>
<div style="padding-right: 1.5cm ">
<div class="nom-more-divider uk-text-center" style="text-align: center"><img src="https://legalinfo.mn/storage/uploads/files/suld1.png" style="margin-top: 40px;"></div>
<div class="w-100 pull-left " data-parentid="" id="1719279682573526" data-pp="0" style="position: relative; font-size: 15px; font-weight: 700; color: #287fe6 !important;; text-align: CENTER; "><div style="padding-left: rem; ">МОНГОЛ УЛСЫН ХУУЛЬ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1719279682717786" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color:#275dff;width:49% !important;margin-botttom:20px:; text-align: LEFT; "><div style="padding-left: rem; ">2024 оны 06 сарын 05 өдөр</div></div>
<div class="w-100 pull-left " data-parentid="" id="1719279682251482" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color:#275dff;width:49% !important; text-align: right !important;margin-botttom:20px:clear:both; text-align: RIGHT; "><div style="padding-left: rem; ">Төрийн ордон, Улаанбаатар хот</div></div>
<div class="w-100 pull-left " data-parentid="" id="1719279682583025" data-pp="0" style="position: relative; font-size: 14px; font-weight: 700; color:#000; text-transform: uppercase; line-height: 22px;margin-top:10px;margin-bottom:10px; width: 70% !important;; margin-left: 15%;; text-align: CENTER; "><div style="padding-left: rem; ">ШҮҮХ БАЙГУУЛАХ ТУХАЙ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1719279682673902" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; color:#222;width:60% !important;margin-left:20%; text-align: CENTER; "><div style="padding-left: rem; ">/Шинэчилсэн найруулга/</div></div>
<div class="w-100 pull-left " data-parentid="" id="1719279682086448" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">1 дүгээр зүйл.Давж заалдах шатны шүүхийг байгуулж, тэдгээрийн байршил, нутаг дэвсгэрийн харьяаллыг доор дурдсанаар тогтооно:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1719279682469861" data-pp="0" style="position: relative; font-size: 13px; font-weight: 400; color:#333;; text-align: JUSTIFY; ">
<div style="padding-left: rem; ">
<table border="1" cellpadding="0" cellspacing="0" style="border-collapse:collapse; border:0.75pt solid #000000; width:475.25pt"></table>
<table border="1" cellpadding="0" cellspacing="0" style="border-collapse:collapse; border:0.75pt solid #000000; width:475.25pt"><tbody>
<tr>
<td style="border-bottom-style:solid; border-bottom-width:0.75pt; border-right-style:solid; border-right-width:0.75pt; height:17.55pt; vertical-align:top; width:20.45pt">
 <p style="text-align:center">№</p>
 </td>
 <td style="border-bottom-style:solid; border-bottom-width:0.75pt; border-left-style:solid; border-left-width:0.75pt; border-right-style:solid; border-right-width:0.75pt; height:17.55pt; vertical-align:top; width:140.7pt">
 <p style="text-align:center">Шүүхийн нэр</p>
 </td>
 <td style="border-bottom-style:solid; border-bottom-width:0.75pt; border-left-style:solid; border-left-width:0.75pt; border-right-style:solid; border-right-width:0.75pt; height:17.55pt; vertical-align:top; width:103.95pt">
 <p style="text-align:center">Байрших газрын нэр</p>
 </td>
 <td style="border-bottom-style:solid; border-bottom-width:0.75pt; border-left-style:solid; border-left-width:0.75pt; height:17.55pt; vertical-align:top; width:179.4pt">
