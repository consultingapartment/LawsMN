<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:doc" xmlns="http://www.w3.org/TR/REC-html40">
<head>
<!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]-->
<meta http-equiv="Content-Type" content="text/html;charset=UTF-8">
<style type="text/css">
body {
            line-height: 12px; 
            font-size: 12px; 
            color: #000; 
            -webkit-print-color-adjust: exact;
        }
@page {mso-page-border-surround-header: no;mso-page-border-surround-footer: no;}
@page Section1 {size:595.45pt 841.7pt;mso-page-orientation:portrait;margin:0.6in 0.6in 0.6in 1in;mso-header-margin:.2in;mso-footer-margin:.2in;mso-paper-source:0;} div.Section1 {page:Section1;}
a, a:visited, a:hover, a:active {
            color: #000;
            text-decoration: none; 
            cursor: default;
        } 
        a:after { content:''; } 
        a[href]:after { content: none !important; }
table {table-layout: fixed;clear: both;border-collapse: collapse;word-wrap: break-word;}
table thead th, table thead td, table tbody td, table tfoot td{overflow: hidden;word-wrap: break-word;padding: 2px 3px}
.right-rotate{mso-rotate: -90;}.left-rotate{mso-rotate: 90;}
</style>
</head>
<body><div class=Section1>
<style type="text/css">* {-webkit-box-sizing:border-box;-moz-box-sizing:border-box;box-sizing:border-box}*:before,*:after {-webkit-box-sizing:border-box;-moz-box-sizing:border-box;box-sizing:border-box}body {margin:0;padding:0;line-height:1.4em;font:12px ;color:#000;width:100%;-webkit-print-color-adjust:exact}a, a:visited, a:hover, a:active {color:inherit;text-decoration:none}a:after { content:''; }a[href]:after { content:none !important; }.navbar, .sidebar-nav {display:none}p {margin:0 0 10px}hr {margin:20px 0;border:0;border-top:1px solid #ddd;border-bottom:0;width:100%}table {table-layout:fixed;clear:both;border-collapse:collapse;page-break-after:auto;font-size:12px;border-color:grey}tr { page-break-inside:avoid; page-break-after:auto }td { page-break-inside:avoid; page-break-after:auto }thead {display:table-header-group}tbody {   display:table-row-group}tfoot {display:table-footer-group}table thead th, table thead td, table tbody td, table tfoot td {overflow:hidden;word-wrap:break-word;padding:2px 3px;line-height:12px}table thead th ul, table thead td ul, table tbody td ul, table tfoot td ul {margin-bottom:0px;padding-left:14px}table.pf-repeat-page-header thead td,table.pf-repeat-page-header thead th,table.pf-repeat-page-header tbody td,table.pf-repeat-page-header tfoot td {padding:2px 3px !important}table.pf-repeat-page-header tbody td table tbody td,table.pf-repeat-page-header tbody td table thead td,table.pf-repeat-page-header tbody td table thead th,table.pf-repeat-page-header tbody td table tfoot td {padding:2px 0 !important}table tbody td table tbody td,table tbody td table thead td,table tbody td table thead th,table tbody td table tfoot td {padding:2px 0 !important}table[border="1"] > thead > tr > td,table[border="1"] > thead > tr > th,table[border="1"] > tbody > tr > td,table[border="1"] > tbody > tr > th,table[border="1"] > tfoot > tr > td,table[border="1"] > tfoot > tr > th {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] {width:100.1% !important}td.pf-st-group-tbl,table.pf-repeat-page-header[border="1"] tbody td.pf-st-group-tbl {padding:0 !important}table.pf-repeat-page-header tbody td table[border="1"] tfoot td {padding:2px 3px !important}.pf-st-group-tbl > table[border="1"] > thead > tr > th {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] > thead > tr > td {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] > tbody > tr > td {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr > td {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr:first-child > td {  border-top:1px #fff solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr > td:first-child {  border-left:1px #fff solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr:last-child > td {  border-bottom:1px #fff solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr > td:last-child {  border-right:1px #fff solid !important}.right-rotate {-webkit-transform:rotate(90deg);-moz-transform:rotate(90deg);-ms-transform:rotate(90deg);-o-transform:rotate(90deg);transform:rotate(90deg);white-space:nowrap;word-wrap:break-word}.left-rotate {-webkit-transform:rotate(270deg);-moz-transform:rotate(270deg);-ms-transform:rotate(270deg);-o-transform:rotate(270deg);transform:rotate(270deg);white-space:nowrap;word-wrap:break-word}.right-rotate span, .left-rotate span {display:block}table.pf-report-table-none,table.pf-report-table-none td,table.pf-report-table-none th {border:0px #fff solid}table.pf-report-table-dotted,table.pf-report-table-dotted td,table.pf-report-table-dotted th {border:1px #000 dotted}table.pf-report-table-dashed,table.pf-report-table-dashed td,table.pf-report-table-dashed th {border:1px #000 dashed}table.pf-report-table-solid,table.pf-report-table-solid td,table.pf-report-table-solid th {border:1px #000 solid}table:has(thead) {min-width:100%}div.print-width-dpi {display:block;min-width:880px;height:1px} a { text-decoration: none;}  ul {padding: 0;list-style: none;} .nom-title {font-size: 11px;line-height: 22px;text-align: center;text-transform: uppercase;color: #2E3B52;max-height: 28px;overflow: hidden;margin-top: 21px;} .nom-header-top .title {font-weight: bold;font-size: 14px;line-height: 22px;color: #2E3B52;text-transform: uppercase;margin-bottom: 0;text-align: center;}.nom-header-top span {font-weight: 700;font-size: 11px;line-height: 22px;color: #000000;}.nom-header-top span {font-weight: 700;font-size: 11px;line-height: 22px;color: #000000;}.nom-more-content .uk-accordion-title {font-weight: 700;font-size: 11px;line-height: 14px;color: #2E3B52;}.nom-more-content .uk-accordion-content p {font-size: 11px;line-height: 22px;color: rgba(46, 59, 82, 0.8);margin-bottom: 0;}.nom-bottom-author {max-width: 545px;margin-left: auto;margin-top: 70px;}.nom-bottom-author h6 {font-weight: 700;font-size: 14px;line-height: 22px;color: #000000;}.uk-flex-between {justify-content: space-between;}.uk-text-center {text-align: center;}.uk-flex {display: flex;}section, p {line-height: 22px;font-size: 14px !important;font-family: Arial, Helvetica, sans-serif !important;}.pull-left {float:left;}.w-100 {width: 100%;}.w-50 {width: 50%;}</style>
<div style="padding-right: 1.5cm ">
<div class="nom-more-divider uk-text-center" style="text-align: center"><img src="https://legalinfo.mn/storage/uploads/files/suld1.png" style="margin-top: 40px;"></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130671275" data-pp="0" style="position: relative; font-size: 15px; font-weight: 700; color: #287fe6 !important;; text-align: CENTER; "><div style="padding-left: rem; ">МОНГОЛ УЛСЫН ХУУЛЬ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130212130" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color:#275dff;width:49% !important;margin-botttom:20px:; text-align: LEFT; "><div style="padding-left: rem; ">2026 оны 05 сарын 08 өдөр</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130323577" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color:#275dff;width:49% !important; text-align: right !important;margin-botttom:20px:clear:both; text-align: RIGHT; "><div style="padding-left: rem; ">Төрийн ордон, Улаанбаатар хот</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130755521" data-pp="0" style="position: relative; font-size: 14px; font-weight: 700; color:#000; text-transform: uppercase; line-height: 22px;margin-top:10px;margin-bottom:10px; width: 70% !important;; margin-left: 15%;; text-align: CENTER; "><div style="padding-left: rem; ">
<p> </p>

<p>ЭРХТЭН, ЭД, ЭС ШИЛЖҮҮЛЭН СУУЛГАХ ТУХАЙ</p>
</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130556269" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; ">НЭГДҮГЭЭР БҮЛЭГ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130329426" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>НИЙТЛЭГ ҮНДЭСЛЭЛ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130868796" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">1 дүгээр зүйл.Хуулийн зорилт</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130436432" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">1.1.Энэ хуулийн зорилт нь хүний эрүүл мэндийг хамгаалах, амьдралын чанарыг сайжруулах зорилгоор сайн дураар эрхтэн, эд, эсээ үнэ төлбөргүй өгөх, шилжүүлэн суулгах цогц үйл ажиллагаа, зохион байгуулалттай холбогдсон харилцааг зохицуулахад оршино.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130533410" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">2 дугаар зүйл.Эрхтэн, эд, эс шилжүүлэн суулгах хууль тогтоомж</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130802463" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">2.1.Эрхтэн, эд, эс шилжүүлэн суулгах хууль тогтоомж нь Монгол Улсын Үндсэн хууль, Эрүүл мэндийн тухай хууль, Эмнэлгийн тусламж, үйлчилгээний тухай хууль, Эрүүл мэндийн даатгалын тухай хууль, Гэр бүлийн тухай хууль, Хөдөлмөрийн тухай хууль, Нийгмийн даатгалын ерөнхий хууль, Нийгмийн даатгалын сангаас олгох тэтгэврийн тухай хууль, Нийгмийн даатгалын сангаас олгох тэтгэмжийн тухай хууль болон энэ хуультай нийцүүлэн гаргасан хууль тогтоомжийн бусад актаас бүрдэнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130215356" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">2.2.Монгол Улсын олон улсын гэрээнд энэ хуульд зааснаас өөрөөр заасан бол олон улсын гэрээний заалтыг дагаж мөрдөнө.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130160529" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">3 дугаар зүйл.Хуулийн үйлчлэх хүрээ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130998926" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">3.1.Энэ хууль хүний эрүүл мэндийг хамгаалах, амьдралын чанарыг сайжруулах зорилгоор эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээ үзүүлэх, донор, реципиентийн эрхийг хамгаалах цогц үйл ажиллагаа, зохион байгуулалттай холбогдсон харилцаанд үйлчилнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130311080" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">3.2.Монгол Улсын олон улсын гэрээнд заасан тохиолдолд гадаад улсын иргэн, харьяалалгүй хүнд эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээг үзүүлнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130827990" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">4 дүгээр зүйл.Хуулийн нэр томьёоны тодорхойлолт</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130513126" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.1.Энэ хуульд хэрэглэсэн дараах нэр томьёог доор дурдсан утгаар ойлгоно:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130826561" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.1."эрхтэн, эд, эс" гэж хүний эрхтэн, эрхтний хэсэг, эдийн нийлмэл бүрдэл болон эсийг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130103734" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.2."амьд донор" гэж бусдын эрүүл мэндийг хамгаалах, амьдралын чанарыг сайжруулах зорилгоор сайн дураар эрхтэн, эд, эсээ өгөгч гэр бүлийн гишүүн, хүргэн, бэрийг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130557871" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.3."амьгүй донор" гэж тархины үйл ажиллагаа бүрэн алдагдсан буюу эргэж сэргэхгүйгээр алдагдсан, тархины үхэл тодорхойлох мэргэшсэн багаар тархины үхэл нь тогтоогдсоны дараа үйл ажиллагаа нь хэвийн явагдаж байгаа эрхтэн, эд, эсийг шилжүүлэн суулгахаар авч болох донорыг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130874512" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.4."эсийн донор" гэж үүдэл эс болон бэлгийн эсийн донорыг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130247829" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.5."тархины үхэл" гэж тархины, эсхүл тархины багана хэсгийн үйл ажиллагаа эргэж сэргэхгүйгээр бүрэн алдагдсан байдлыг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130438055" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.6."реципиент" гэж донорын эрхтэн, эд, үүдэл эсийг шилжүүлэн суулгах зайлшгүй шаардлагатай болон шилжүүлэн суулгасан хүнийг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130537450" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.7."реципиент эмнэлэг" гэж бүтцэд нь төрөлжсөн тасаг, мэргэжлийн багтай Эрүүл мэндийн тухай хуулийн 15.1.11, 15.1.13-т заасан эрүүл мэндийн байгууллагыг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130542611" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.8."донор эмнэлэг" гэж амьгүй донорыг илрүүлэх, оношлох, эрхтэн хамгаалах үйл ажиллагааг зохион байгуулах, эмнэлгийн тусламж, үйлчилгээ үзүүлэх чиг үүрэг бүхий Эрүүл мэндийн тухай хуулийн 15.1.7, 15.1.11, 15.1.13-т заасан эрүүл мэндийн байгууллагыг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130526312" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.9."үүдэл эс" гэж хуваагдах замаар шинэ эс үүсгэх, ялгаран хөгжих чадвартай эсийг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130450123" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.10."хүйн цус" гэж нярайн хүй таслагдсаны дараа ихсийн хүйн судсанд байгаа цусыг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130423611" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.11."био банк" гэж оношилгоо, эмчилгээ, судалгаа болон урьдчилан сэргийлэх, хяналт хийх зорилгоор авсан эд, эсийг хадгалах тусгай зориулалтын санг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130238406" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.12."эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээ" гэж эмнэлгийн нөхцөлд донорыг илрүүлэх, оношлох, эрхтэн, эд, эсийг авах, шинжлэх, боловсруулах, хадгалах, тээвэрлэх, хуваарилах, шилжүүлэн суулгах, устгах болон мэс заслын дараах эмчилгээ, хяналт хийх эмнэлгийн тусламж, үйлчилгээг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130120343" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.13."эрхтэн, эд, эсийг авах" гэж донороос эрхтэн, эд, эсийг эмнэлгийн нөхцөлд авахыг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130400018" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.14."эд, эсийн тохироо" гэж донор болон реципиентийн эд, эс удам зүйн шинжээрээ тохирсон байдлыг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130234550" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.15."тээгч эх" гэж бусдын үр хөврөлийг тээж, хүүхэд төрүүлэх эмэгтэй хүнийг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130297402" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.16."биологийн эцэг, эх" гэж тухайн хүүхдийн удмын мэдээллийг бүрдүүлсэн эцэг, эхийг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130631646" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.17."сорьц" гэж оношилгоо, эмчилгээ, судалгаа болон урьдчилан сэргийлэх, хяналт хийх зорилгоор хүнээс авсан цус, эрхтний хэсэг, эд, эсийг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130911194" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.18."хүйн эд" гэж нярайн хүй таслагдсаны дараа ихэстэй залгаа хэсгээс тайран авсан хүйн судсан багцыг;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130042752" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">4.1.19."үндэсний хүлээх жагсаалт" гэж эрхтэн, эд, эс шилжүүлэн суулгуулах шаардлагатай иргэнийг эрхтэн, эд, эс, цусны бүлгээр ангилан, эмнэл зүйн үнэлгээ, шалгуур үзүүлэлтээр эрэмбэлэн бүртгэсэн жагсаалтыг.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130122298" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">5 дугаар зүйл.Эрхтэн, эд, эс шилжүүлэн суулгах үйл ажиллагаанд баримтлах зарчим</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130337520" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">5.1.Эрхтэн, эд, эс шилжүүлэн суулгах үйл ажиллагаанд дараах зарчмыг баримтална:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130023668" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">5.1.1.хууль, хүний эрхийг дээдлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130887391" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">5.1.2.хүмүүнлэг, энэрэнгүй байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130075549" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">5.1.3.ялгаварлан гадуурхахгүй байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130519790" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">5.1.4.хүний эрүүл мэндтэй холбоотой мэдээллийн нууцыг хамгаалах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130623185" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">5.1.5.донор нь авлагагүй, сайн дурын, аливаа дарамт шахалт, бусдын нөлөөнд автаагүй байх.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130170153" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; ">ХОЁРДУГААР БҮЛЭГ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130044926" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>РЕЦИПИЕНТ БОЛОН АМЬД ДОНОРТ ТАВИХ ШААРДЛАГА, ТЭДГЭЭРИЙН ЭРХ, ҮҮРЭГ, АМЬГҮЙ ДОНОРЫГ ИЛРҮҮЛЭХ, БҮРТГЭХ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130576458" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "></div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573130706325" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">6 дугаар зүйл.Реципиентэд тавих шаардлага</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131604179" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">6.1.Реципиентэд дараах шаардлага тавигдана:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131136571" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">6.1.1.реципиент эмнэлгээс эрхтэн, эд, эс шилжүүлэн суулгах эмчилгээ хийлгэх заалт бүхий реципиентийг тодорхойлсон дүгнэлт, шийдвэр гарсан байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131606593" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">6.1.2.реципиент өөрийн хүсэлтээр үндэсний хүлээх жагсаалтад бүртгүүлсэн байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131151566" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">6.1.3.эрхтэн, эд, эс шилжүүлэн суулгах зөвшөөрлийг 18 насанд хүрсэн бол өөрөөс нь, хүүхэд, эрх зүйн бүрэн чадамжгүй иргэн бол түүний эцэг, эх, хууль ёсны асран хамгаалагч, харгалзан дэмжигчээс бичгээр авсан байх.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131397051" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">6.2.Эрхтэн, эд, эс шилжүүлэн суулгуулах гадаад улсын иргэн, харьяалалгүй хүнд энэ хуулийн 6.1.1, 6.1.3-т зааснаас гадна дараах шаардлагыг тавина:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131911838" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">6.2.1.Монгол Улсын иргэнтэй гэр бүл болсон буюу Монгол Улсад байнга оршин суугаа гадаад улсын иргэн, харьяалалгүй хүн гэрлэлтээ бүртгүүлснээс хойш гурваас доошгүй жил, бэлгийн эс шилжүүлэн суулгах тохиолдолд нэгээс доошгүй жил Монгол Улсад хамтран амьдарсан байх, хэрэв гэрлэгчид дундаасаа төрсөн хүүхэдтэй бол жил харгалзахгүй байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131569121" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">6.2.2.Монгол Улсад гадаад улсын иргэн, харьяалалгүй хүн эрхтэн, эд, эс шилжүүлэн суулгуулах эмчилгээ хийлгэх тохиолдолд энэ хуулийн 8 дугаар зүйлд заасан шаардлагад нийцсэн донортой байх.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131201345" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">7 дугаар зүйл.Реципиентийн эрх, үүрэг</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131145165" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">7.1.Реципиент дараах эрх, үүрэгтэй:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131559027" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">7.1.1.үндэс, угсаа, хэл, арьсны өнгө, нас, хүйс, нийгмийн гарал, байдал, хөрөнгө чинээ, эрхэлсэн ажил, албан тушаал, шашин шүтлэг, үзэл бодол, боловсрол харгалзахгүйгээр хүн эрүүл мэндээ хамгаалах, амьдралын чанараа сайжруулах зорилгоор донорын эрхтэн, эд, эсийг шилжүүлэн суулгуулах мэс засал, эмчилгээг хийлгэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131732633" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">7.1.2.эмнэлгийн тусламж, үйлчилгээ, гарч болох эрсдэл, хүндрэлийн талаар мэдээлэл авах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131271226" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">7.1.3.эмч, эмнэлгийн хяналтад тогтмол үзүүлэх, амьдралын чанарыг сайжруулах, эрүүл мэндийн тусламж, үйлчилгээг тасралтгүй хүртээмжтэйгээр авах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131633410" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">7.1.4.эмнэлгийн тусламж, үйлчилгээтэй холбоотой эрүүл мэндийн байгууллага, эмнэлгийн мэргэжилтний өгсөн заавар, зөвлөгөөг дагаж мөрдөх.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131480726" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">8 дугаар зүйл.Амьд донорт тавих шаардлага</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131332661" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">8.1.Амьд донор дараах шаардлагыг хангасан байна:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131854625" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">8.1.1. 21 насанд хүрсэн байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131704997" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">8.1.2.энэ хуулийн 4.1.2-т заасан гэр бүлийн гишүүн, хүргэн, бэр байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131985382" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">8.1.3.гэрлэгч нь гэрлэлтээ бүртгүүлснээс хойш гурваас доошгүй жил болсон байх, хэрэв гэрлэгчид дундаасаа төрсөн хүүхэдтэй бол жил харгалзахгүй байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131311982" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">8.1.4.донор болох шийдвэрээ сайн дураар бие даан гаргасан, өөрийн шийдвэрийн эрсдэл, үр дагаврыг бүрэн ухамсарласан, хөгжлийн бэрхшээлгүй болон сэтгэцийн эмгэггүй гэдгийг эрх бүхий байгууллагаар тодорхойлуулсан байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131370546" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">8.1.5.ашгийн төлөө бус, авлагагүй, сайн дурын байх.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131821061" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">8.2.Эсийн донор дараах шаардлагыг хангасан байна:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131230127" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">8.2.1.эсийн донорт насны хязгаар заахгүй ба хэрэв бэлгийн эсийн донор бол 18 насанд хүрсэн байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131394679" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">8.2.2.хүүхдээс ясны хэм, захын цус авахдаа 14 хүртэлх настай бол хүүхдийн хүсэл зоригийг хүндэтгэн эцэг, эх болон асран хамгаалагчийн, 14-өөс дээш настай бол өөрийнх нь болон эцэг, эх, харгалзан дэмжигч, асран хамгаалагчийн зөвшөөрлийг бичгээр авсан байх.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131524576" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">8.3.Эсийн донор нь гэр бүлийн гишүүн, эсхүл сайн дурын донор байж болно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131004403" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">8.4.Хүүхдээс ясны хэм, хүйн цус, хүйн эд, захын цуснаас бусад эрхтэн, эд, эсийг шилжүүлэн суулгах зориулалтаар авахыг хориглоно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131218618" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">9 дүгээр зүйл.Амьд донорын эрх, үүрэг</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131888225" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">9.1.Амьд донор дараах эрх, үүрэгтэй:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131242700" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">9.1.1.донор нь үндэс, угсаа, хэл, арьсны өнгө, нас, хүйс, нийгмийн гарал, байдал, хөрөнгө чинээ, эрхэлсэн ажил, албан тушаал, шашин шүтлэг, үзэл бодол, боловсролоороо ялгаварлан гадуурхагдахгүй байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131050222" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">9.1.2.эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээний талаар мэдээлэл авах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131375826" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">9.1.3.эмч, эмнэлгийн хяналтад тогтмол байх, эрүүл мэндийн тусламж, үйлчилгээг чанар, хүртээмжтэйгээр авах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131804283" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">9.1.4.эмнэлгийн тусламж, үйлчилгээтэй холбоотой эрүүл мэндийн байгууллага, эмнэлгийн мэргэжилтний өгсөн заавар, зөвлөгөөг дагаж мөрдөх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131484187" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">9.1.5.амьд донор болсны төлөө реципиент, түүний гэр бүлийн гишүүнээс аливаа хэлбэрээр ашиг олох зорилгоор шан харамж авахгүй, өгөхийг шаардахгүй байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131639235" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">9.1.6.эрхтэн, эд, эсээ бусдад шилжүүлэн суулгах явцад өөрийн эрүүл мэнд, амь нас, аюулгүй байх эрхээр хангагдах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131735897" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">9.1.7.эрхтэн, эд, эсийг шилжүүлэн суулгах тусламж, үйлчилгээний явцад технологийн заавар зөрчигдсөний улмаас эрүүл мэндэд хохирол учруулсан нь тогтоогдсон бол эрхтэн, эд, эсийг шилжүүлэн суулгасан буруутай этгээд, байгууллагаар хохирлоо нөхөн төлүүлэх.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131282402" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">10 дугаар зүйл.Амьгүй донорыг илрүүлэх</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131417166" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">10.1.Тархины үхэл тодорхойлох мэргэшсэн багаар тархины үхэлтэй болох нь тогтоогдсон тохиолдолд амьгүй донороос эрхтэн, эд, эс авна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131042533" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">10.2.Энэ хуулийн 10.1-д заасан донорын эхнэр, нөхөр, төрүүлсэн болон үрчилж авсан эцэг, эх, төрсөн хүүхэд, төрсөн ах, эгч, дүү, төрлийн хүн, садангийн хүн гэсэн дарааллаар гэр бүлийн гишүүдийн гурав хүртэлх гишүүнээс зөвшөөрлийг бичгээр авсан байна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131879207" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">10.3.Амьгүй донорын эрхтэн, эд, эсийг зөвхөн Монгол Улсын иргэнд шилжүүлэн суулгана.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131323231" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">10.4. 18 хүртэлх насны амьгүй донорын эрхтэн, эд, эсийг хүүхэд, насанд хүрсэн хүн гэсэн дарааллаар шилжүүлэн суулгана.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131148668" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">10.5.Гэмт хэргийн улмаас тархины үхэлтэй болох нь эрх бүхий байгууллагаас тогтоогдсон амьгүй донороос эрхтэн, эд, эс авах тохиолдолд холбогдох журмыг эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагын саналыг үндэслэн эрүүл мэндийн болон хууль зүйн асуудал эрхэлсэн Засгийн газрын гишүүн, Улсын ерөнхий прокурор хамтран батална.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131723351" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">10.6.Амьгүй донорт насны хязгаар заахгүй.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131612933" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">11 дүгээр зүйл.Донор болох хүсэлтээ илэрхийлэх</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131506473" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">11.1. 21 насанд хүрсэн Монгол Улсын иргэн энэ хуулийн 4.1.3-т заасан донор болох хүсэлтээ төрийн цахим үйлчилгээний нэгдсэн системээр дамжуулан гаргаж, донорын цахим үнэмлэх, эсхүл эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагад өөрийн биеэр хүсэлт гарган баталгаажуулж, донорын үнэмлэх авч болно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131310769" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">11.2.Энэ хуулийн 11.1-д заасан иргэн донор болох хүсэлтээсээ хугацаа харгалзахгүй татгалзах эрхтэй.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131244486" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">11.3.Энэ хуулийн 11.1-д заасан иргэн донор болох хүсэлтээсээ татгалзах хүсэлтээ төрийн цахим үйлчилгээний нэгдсэн системээр дамжуулан, эсхүл эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагад өөрийн биеэр хүсэлт гарган баталгаажуулна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131789812" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; ">ГУРАВДУГААР БҮЛЭГ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131248627" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>ЭРХТЭН, ЭД, ЭС ШИЛЖҮҮЛЭН СУУЛГАХ ТУСЛАМЖ, ҮЙЛЧИЛГЭЭ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131636613" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">12 дугаар зүйл.Донороос эрхтэн, эд, эс авах</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131418224" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">12.1.Амьд донороос эрхтэн, эд, эсийг шилжүүлэн суулгах тохиолдолд энэ хуулийн 8.1, 8.2-т заасан шаардлагыг хангасан байна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131916979" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">12.2.Амьгүй донороос эрхтэн, эд, эс авах тохиолдолд шилжүүлэн суулгах эрхтэн, эд, эсийн талаар түүний гэр бүлийн гишүүдэд урьдчилан танилцуулж, энэ хуулийн 10.2-т заасан зөвшөөрлийг авах бөгөөд зөвшөөрснөөс бусад эрхтэн, эд, эс авахыг хориглоно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131550574" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">12.3.Энэ хуулийн 11.1-д заасны дагуу донор болох хүсэлтээ баталгаажуулсан амьгүй донороос эрхтэн, эд, эс авахдаа гэр бүлийн гурав хүртэлх гишүүнд урьдчилан танилцуулах бөгөөд энэ хуулийн 10.2-т заасан зөвшөөрлийг авахгүй.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131182911" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">12.4.Донор эмнэлэг нь амьгүй донорыг тодорхойлж, эрхтэн, эд, эс авах бэлтгэлийг хангаж, эрхтэн хамгаалах үйл ажиллагааг зохион байгуулна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131320861" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">12.5.Эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагын зөвшөөрсний дагуу реципиент эмнэлгийн эрхтэн, эд, эс шилжүүлэн суулгах мэргэжлийн баг эрхтэн, эд, эс авах эмнэлгийн тусламж, үйлчилгээг гүйцэтгэнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131935323" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">12.6.Амьд болон амьгүй донорыг бүртгэх, илрүүлэх, эрхтэн, эд, эс авах, шинжлэх, сонгох, хуваарилах, боловсруулах, хадгалах, хамгаалах, тээвэрлэх, шилжүүлэн суулгах, хянах, устгах журмыг эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагын саналыг үндэслэн эрүүл мэндийн асуудал эрхэлсэн Засгийн газрын гишүүн батална.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131638715" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">13 дугаар зүйл.Био банк байгуулах, ашиглах үйл ажиллагаа</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131572461" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">13.1.Эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллага нь улсын хэмжээнд оношилгоо, эмчилгээ, судалгаа болон урьдчилан сэргийлэх, хяналт хийх зориулалттай нэгдсэн био банктай байна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131122404" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">13.2.Био банк байгуулах, ашиглах журмыг эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагын саналыг үндэслэн эрүүл мэндийн асуудал эрхэлсэн Засгийн газрын гишүүн батална.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131811380" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">13.3.Эрхтэн, эд, эс шилжүүлэн суулгах үйл ажиллагаанд оролцож байгаа эрүүл мэндийн байгууллага нь эд, эс шилжүүлэн суулгах тусламж, үйлчилгээнд хэрэглэгдэх био банктай байж болно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131274971" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">13.4.Био банкийг эд, эсийг цуглуулах, шинжлэх, өсгөвөрлөх, боловсруулах, хадгалах, бүртгэх, тээвэрлэх, устгах, шаардлагатай үед эмчилгээ, судалгааны зорилгоор тохирох эд, эсээр реципиент эмнэлэг болон судалгаа, шинжилгээний байгууллагыг хангах зориулалтаар ашиглана.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131852293" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">14 дүгээр зүйл.Донорын эрхтэн, эд, эсийг улсын хилээр нэвтрүүлэх</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131357106" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">14.1.Эрхтэн, эд, эсийг экспортлохыг хориглоно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131041323" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">14.2.Монгол Улсын олон улсын гэрээ, хэлэлцээрийн дагуу эмчилгээний зорилгоор эд, эсийг энэ хуулийн 14.3-т заасан журмын дагуу импортолж болно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131244749" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">14.3.Донорын сорьц, эд, эсийг улсын хилээр нэвтрүүлэх журмыг эрүүл мэндийн асуудал эрхэлсэн төрийн захиргааны төв байгууллагын саналыг үндэслэн Засгийн газар батална.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131182478" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">15 дугаар зүйл.Эрхтэн, эд, эсийг шилжүүлэн суулгах тусламж, үйлчилгээнд тавих шаардлага</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131135372" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">15.1.Реципиент эмнэлэг нь донор, реципиентийн эрхтэн, эд, эсийн тохироог үзэх, донороос авсан эрхтэн, эд, эсийг шинжлэх, боловсруулах, шилжүүлэн суулгах мэс засал, эмчилгээг гүйцэтгэх мэргэжлийн багтай байна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131092261" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">15.2.Эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээнд олон улсын чанарын шаардлага хангасан эм, эмнэлгийн хэрэгслийг ашиглана.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131601532" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">15.3.Эс шилжүүлэн суулгах эмчилгээнд үүдэл эсийг ашиглахдаа энэ хуулийн 12.6-д заасан журмыг дагаж мөрдөнө.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131981332" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">15.4.Бэлгийн эсийг үр шилжүүлэн суулгах эмчилгээнд ашиглаж болно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131787071" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">15.5.Эс шилжүүлэн суулгах эмчилгээг Эрүүл мэндийн тухай хуулийн 15.1.4-т заасан эрүүл мэндийн байгууллага гүйцэтгэж болно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131223931" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">15.6.Холбогдох эрүүл мэндийн байгууллагын дүгнэлтээр өөрөө жирэмслэх, ураг тээх, хүүхэд төрүүлэх чадваргүй нь тогтоогдсон эмэгтэйд тээгч эхээр дамжуулан хүүхэдтэй болохыг зөвшөөрөх бөгөөд бусад тохиолдолд тээгч эх ашиглахыг хориглоно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131942027" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">15.7.Бэлгийн эс ашиглах, үр хөврөлийг шилжүүлэн суулгах, тээгч эхэд үзүүлэх тусламж, үйлчилгээг үзүүлэхдээ энэ хуулийн 12.6-д заасан журмыг баримтлах бөгөөд талуудын хооронд байгуулах гэрээний загварыг эрүүл мэндийн асуудал эрхэлсэн Засгийн газрын гишүүн батална.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131398013" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">15.8.Тээгч эхээс төрсөн хүүхдийн төрсний бүртгэлийг биологийн эцэг, эхийн овог, нэрээр бүртгэнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131014133" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">15.9.Нэг донорын бэлгийн эсийг зөвхөн тухайн нэг гэр бүлд ашиглахыг зөвшөөрнө.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131944472" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">15.10.Үр хөврөлийг эцэг, эхээс нь бусад хүнд ашиглуулахыг хориглоно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131416130" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">16 дугаар зүйл.Эрхтэн, эд, эс шилжүүлэн суулгах үйл ажиллагааны</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131709896" data-pp="0" style="position: relative; font-size: 13px; font-weight: 400; color:#333;; text-align: JUSTIFY; "><div style="padding-left: rem; ">нэгдсэн бүртгэл мэдээллийн сан</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131480673" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">16.1.Эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллага нь нэгдсэн бүртгэл мэдээллийн сантай байна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131744166" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">16.2.Эрхтэн, эд, эс шилжүүлэн суулгах үйл ажиллагааны нэгдсэн бүртгэл мэдээллийн сангийн ажиллах журмыг эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллага батална.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131338471" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; ">ДӨРӨВДҮГЭЭР БҮЛЭГ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131880956" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>ЭРХТЭН, ЭД, ЭС ШИЛЖҮҮЛЭН СУУЛГАХ ҮЙЛ АЖИЛЛАГААНЫ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131337376" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>УДИРДЛАГА, БҮТЭЦ, ЗОХИОН БАЙГУУЛАЛТ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131902041" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">17 дугаар зүйл.Эрхтэн, эд, эс шилжүүлэн суулгах үйл ажиллагааны талаарх Засгийн газрын бүрэн эрх</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131512346" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">17.1.Эрхтэн, эд, эс шилжүүлэн суулгах үйл ажиллагааны талаар Засгийн газар дараах бүрэн эрхийг хэрэгжүүлнэ:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131496815" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">17.1.1.эрхтэн, эд, эс шилжүүлэн суулгах хууль тогтоомжийн хэрэгжилтэд хяналт тавих;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131992417" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">17.1.2.Засгийн газар хоорондын болон олон улсын байгууллагатай гэрээ, хэлэлцээр байгуулах, төсөл, хөтөлбөр хэрэгжүүлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131310739" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">17.1.3.эрхтэн, эд, эс шилжүүлэн суулгах тогтолцоог бүрдүүлэх, үүнтэй холбоотой зардлын санхүүжилтийн эх үүсвэрийг шийдвэрлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131917254" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">17.1.4.хууль тогтоомжид заасан бусад бүрэн эрх.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131260808" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">18 дугаар зүйл.Эрүүл мэндийн асуудал эрхэлсэн төрийн захиргааны төв байгууллагын чиг үүрэг</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131222671" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">18.1.Эрүүл мэндийн асуудал эрхэлсэн төрийн захиргааны төв байгууллага эрхтэн, эд, эсийг шилжүүлэн суулгах тусламж, үйл ажиллагааны талаар дараах чиг үүргийг хэрэгжүүлнэ:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131283214" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">18.1.1.эрхтэн, эд, эс шилжүүлэн суулгах хууль тогтоомжийн хэрэгжилтийг хангах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131098041" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">18.1.2.эрхтэн, эд, эсийг шилжүүлэн суулгах тусламж, үйлчилгээний талаар баримтлах бодлого, төлөвлөлт, арга хэмжээ, хөтөлбөр боловсруулах, биелэлтийг хангуулах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131107693" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">18.1.3.энэ хуульд заасан холбогдох үйл ажиллагааг хэрэгжүүлэхэд шаардлагатай төсвийг эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагын саналыг үндэслэн эрх бүхий байгууллагаар шийдвэрлүүлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131767415" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">18.1.4.эрхтэн, эд, эсийг шилжүүлэн суулгах цогц үйл ажиллагаа, эмнэлгийн тусламж, үйлчилгээтэй холбогдох дүрэм, журам, заавар батлах, тэдгээрийн хэрэгжилтэд нь хяналт тавих;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131957766" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">18.1.5.эрхтэн, эд, эс шилжүүлэн суулгах үйл ажиллагааг хэрэгжүүлэхтэй холбоотойгоор мэргэжилтэн бэлтгэх, мэдлэг боловсрол, ур чадварыг дээшлүүлэх сургалтад хамруулах, эдгээртэй холбоотой зардлыг шийдвэрлэх, бодлогоор дэмжиж ажиллах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131552137" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">18.1.6.хуульд заасан бусад чиг үүрэг.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131578938" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">18.2.Эрүүл мэндийн асуудал эрхэлсэн төрийн захиргааны төв байгууллагын дэргэд эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээний асуудлаар мэргэжил, ёс зүйн хороо ажиллах бөгөөд тус хорооны дүрэм, бүрэлдэхүүнийг эрүүл мэндийн асуудал эрхэлсэн Засгийн газрын гишүүн батална.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131627944" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">18.3.Эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагын бүтэц, дүрмийг эрүүл мэндийн асуудал эрхэлсэн Засгийн газрын гишүүн батална.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131413339" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">19 дүгээр зүйл.Эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагын чиг үүрэг</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131577721" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">19.1.Эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллага нь Эрүүл мэндийн тухай хуульд заасан тусгай мэргэжлийн төв байна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131568590" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">19.2.Эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллага эрхтэн, эд, эс шилжүүлэн суулгах чиглэлээр дараах үйл ажиллагааг хэрэгжүүлнэ:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131730197" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.2.1.эрхтэн, эд, эс шилжүүлэн суулгах үйл ажиллагааг мэргэжил, арга зүйн удирдлагаар хангах, уялдуулан зохион байгуулах, хэрэгжилтэд нь хяналт тавих;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131808821" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.2.2.донор эмнэлэг болон эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээг үзүүлэх эрүүл мэндийн байгууллагатай хамтран ажиллах ба энэ хуулийн 12.6, 13.2-т заасан журмыг хэрэгжүүлэх үйл ажиллагааг нэгдсэн удирдлагаар хангаж, хяналт тавих;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131995671" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.2.3.эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээтэй холбоотойгоор иргэн, эмчлүүлэгчид эрсдэл үүсэх, хохирол учрахаас урьдчилан сэргийлэх арга хэмжээг холбогдох байгууллагатай хамтран хэрэгжүүлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131907410" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.2.4.эрхтэн, эд, эс шилжүүлэн суулгах үйл ажиллагааны нэгдсэн бүртгэл мэдээллийн санг ажиллуулах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131513228" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.2.5.үндэсний хүлээх жагсаалтад реципиентийг бүртгэх.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131352830" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">19.3.Эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллага сургалт, судалгаа, хамтын ажиллагааны чиглэлээр дараах үйл ажиллагааг хэрэгжүүлнэ:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131254084" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.3.1.эрхтэн, эд, эсийг шилжүүлэн суулгах тусламж, үйлчилгээний талаарх мэдээ, тайланг улсын хэмжээнд нэгтгэн гаргах, дүн шинжилгээ, судалгаа хийх, холбогдох төрийн байгууллагыг нотолгоонд суурилсан мэдээллээр хангах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131694131" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.3.2.эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээний чиглэлээр ижил төстэй үйл ажиллагаа эрхэлдэг олон улсын байгууллага, төрийн болон төрийн бус байгууллагатай хамтран ажиллах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131323662" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.3.3.эмнэлгийн мэргэжилтнийг чадавхжуулах, багийн чадавхыг дээшлүүлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131883709" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.3.4.эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээнд орчин үеийн шинэ технологи, арга аргачлалыг нэвтрүүлэх, иргэн эх орондоо эмчлүүлэх нөхцөл бололцоог бүрдүүлэх үйл ажиллагааг дэмжин ажиллах.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131387628" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">19.4.Эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллага амьгүй донорыг илрүүлэх, эрхтэн, эд, эс хуваарилах, зохицуулах чиглэлээр дараах үйл ажиллагааг хэрэгжүүлнэ:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131717693" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.4.1.Эрүүл мэндийн тухай хуулийн 15.1.7, 15.1.11, 15.1.13-т заасан байгууллагын амьгүй донорыг илрүүлэх, тархины үхэл тодорхойлох багт мэргэжил, арга зүйн зөвлөгөө өгөх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131307530" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.4.2.улсын хэмжээнд амьгүй донорын тандалт хийх, илрүүлэх, бүртгэх тогтолцоог удирдан зохион байгуулж, байгууллага хоорондын уялдаа холбоог хангах, мэргэжил, арга зүйн зөвлөгөө өгөх, хяналт тавьж хамтран ажиллах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131387629" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.4.3.амьгүй донорын гэр бүлтэй уулзах, эрхтэн, эд, эсийн донор болгох хүсэлт тавих;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131026612" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.4.4.реципиент болон донор эмнэлгийн хүчин чадал, чадамжийг сайжруулах, эмнэлгийн мэргэжилтнийг чадавхжуулах үйл ажиллагааг дэмжих, үр дүнг тооцох тогтолцоо бий болгох;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131117308" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.4.5.реципиент болон донор эмнэлэгтэй хамтран ажиллах гэрээг батлах, хэрэгжилтийг хянах, цуцлах.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131217464" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">19.5.Эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллага ёс зүй, олон нийттэй харилцах чиглэлээр дараах үйл ажиллагааг хэрэгжүүлнэ:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131331151" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.5.1.эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээ үзүүлж байгаа эрүүл мэндийн байгууллага, эмнэлгийн мэргэжилтний ёс зүйн хэм хэмжээнд хяналт тавьж Эрүүл мэндийн тухай хуулийн 26.1, 26.5-д заасан мэргэжил, ёс зүйн хороодтой хамтран ажиллах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131232216" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.5.2.эрхтэн, эд, эсийг шилжүүлэн суулгах асуудлаар иргэн, хуулийн этгээдээс ирүүлсэн өргөдөл, гомдлыг шийдвэрлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131730311" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.5.3.хүний наймаа болон хүний эрхтэн, эд, эсийн наймаатай холбоотой аливаа хууль зөрчсөн үйлдлийн талаар холбогдох хууль хяналтын байгууллагад мэдэгдэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131068534" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.5.4.эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээний талаар иргэд, олон нийтэд үнэн зөв мэдээлэл өгөх, таниулах, ойлгуулах үйл ажиллагааг боловсролын болон хэвлэл мэдээллийн байгууллагатай хамтран зохион байгуулах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131400218" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">19.5.5.хуульд заасан бусад үйл ажиллагаа.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131533370" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">20 дугаар зүйл.Эрүүл мэндийн байгууллагын нийтлэг чиг үүрэг</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131721696" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">20.1.Реципиент эмнэлгийн бүтцэд мэргэжлийн баг, нэгж ажиллана.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131521042" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">20.2.Реципиент болон донор эмнэлэг нь эрхтэн, эд, эс шилжүүлэн суулгах эмчилгээний болон донорын талаарх мэдээллийг эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагад тухай бүр үнэн зөв мэдээлж, улирал тутам тайлагнана.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131914091" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">20.3.Эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээ үзүүлэх эрүүл мэндийн байгууллага дараах чиг үүргийг хэрэгжүүлнэ:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131368794" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.3.1.амьд донорын эрүүл мэндэд учирч болзошгүй эрсдэл, хүндрэлээс сэргийлэх үзлэг, шинжилгээ хийх, хяналт тавих;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131641046" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.3.2.реципиентэд тавих нөхцөл, шаардлага, үзүүлэлт хангасан хүнийг үндэсний хүлээх жагсаалтад бүртгүүлэхээр эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагад мэдээлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131622492" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.3.3.эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээтэй холбоотой мэдээллийг энэ хуулийн 19.2.4-т заасан санд тухай бүр оруулах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131414917" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.3.4.эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээг эрх бүхий байгууллагаас баталсан журам, заавар, стандарт, технологийн дагуу гүйцэтгэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131645690" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.3.5.эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээний бэлэн байдлыг хангах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131339717" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.3.6.эмнэлгийн мэргэжилтнийг мэргэшүүлэн бэлтгэх, сургах, хүний нөөцийг чадавхжуулах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131502314" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.3.7.эрхтэн, эд, эсийг авах, шинжлэх, боловсруулах, хадгалах, шилжүүлэн суулгах тусламж, үйлчилгээний явцад тохиолдож болох хүндрэл, эрсдэлээс сэргийлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131801860" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.3.8.эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээнд орчин үеийн шинэ технологи, арга аргачлалыг нэвтрүүлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131044091" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.3.9.амьд донор болон реципиентэд байнгын хяналт тавих;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131252850" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.3.10.аймаг, дүүргийн нэгдсэн эмнэлгийн зохих эмнэлгийн мэргэжилтэнд эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээний чиглэлээр сургалт зохион байгуулах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131113389" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.3.11.хуульд заасан бусад чиг үүрэг.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131082193" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">20.4.Донор эмнэлэг нь дараах чиг үүргийг хэрэгжүүлнэ:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131048625" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.4.1.эрүүл мэндийн байгууллагын бүтцэдээ тархины үхэл тодорхойлох мэргэшсэн баг ажиллуулах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131310052" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.4.2.амьгүй донорыг илрүүлэх, оношлох, эрхтэн хамгаалах үйл ажиллагааг холбогдох журмын дагуу зохион байгуулах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131922488" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.4.3.амьгүй донор эмчлүүлж байгаа төв, тасаг, нэгжийн эм, эмнэлгийн хэрэгсэл болон бэлэн байдлыг хангах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131624400" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.4.4.амьгүй донорын талаарх мэдээллийг эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагад тухай бүр мэдээлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131830163" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.4.5.эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээ үзүүлэх эрүүл мэндийн байгууллагаас ажиллах багийн үйл ажиллагааг дэмжин ажиллах, шаардлагатай нөхцөлийг бүрдүүлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131764702" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.4.6.тухайн эрүүл мэндийн байгууллагад донорын эрхтэн, эд, эсийг авах мэс заслыг гүйцэтгэх боломжгүй тохиолдолд амьгүй донорын амин чухал эрхтний үйл ажиллагааг дэмжин, эрчимт эмчилгээг үргэлжлүүлэх, зөөвөрлөх бэлэн байдлыг хангуулах талаар эрхтэн, эд, эс шилжүүлэн суулгах асуудал хариуцсан эрүүл мэндийн байгууллагатай хамтран ажиллах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131616968" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.4.7.эрхтэн, эд, эсийг шилжүүлэн суулгах мэс засал, эмчилгээнд оролцож байгаа болон реципиентийн эмчлэгч эмчийг тархины үхэл тодорхойлох мэргэжлийн багийн бүрэлдэхүүнд орохыг хориглох;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131670314" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">20.4.8.хуульд заасан бусад чиг үүрэг.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131313851" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">21 дүгээр зүйл.Эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээ үзүүлэх эрүүл мэндийн байгууллага, эмнэлгийн мэргэжилтэнд хориглох зүйл</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131887842" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">21.1.Эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээ үзүүлэх эрүүл мэндийн байгууллага, эмнэлгийн мэргэжилтэнд дараах үйл ажиллагааг хориглоно:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131392086" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">21.1.1.донор болон реципиент, тэдний гэр бүлийн гишүүн, тэдгээрийн хамаарал бүхий этгээдээс аливаа хэлбэрээр урамшуулал, шан харамж авах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131316720" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">21.1.2.албан тушаалын эрх мэдлээ урвуулан ашиглаж, бусдад давуу байдал олгох;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131158752" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">21.1.3.шинжлэх ухааны бус зорилгоор судалгаа, шинжилгээ, туршилт хийх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131754668" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">21.1.4.хуульд заасан бусад.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131485580" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">22 дугаар зүйл.Амьгүй донорын гэр бүлд олгох тэтгэмж болон амьд донорт үзүүлэх дэмжлэг</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131591662" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">22.1.Хөдөлмөрийн хөлсний доод хэмжээг 10 дахин нэмэгдүүлсэнтэй тэнцэх хэмжээний оршуулгын тэтгэмжийг Эрүүл мэндийг дэмжих сангаас олгоно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131529771" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">22.2.Амьд донорт эмнэлгийн тусламж, үйлчилгээг хөнгөлөлттэй үзүүлэх журмыг эрүүл мэндийн асуудал эрхэлсэн Засгийн газрын гишүүн, рашаан, сувилалд сувилуулах журмыг гэр бүл, хөдөлмөр, нийгмийн хамгааллын асуудал эрхэлсэн Засгийн газрын гишүүн батална.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131989201" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">22.3.Донорт хуульд заасан бусад дэмжлэг үзүүлнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131361958" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; ">ТАВДУГААР БҮЛЭГ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131333194" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>БУСАД ЗҮЙЛ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131721859" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">23 дугаар зүйл.Санхүүжилтийн тогтолцоо</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131552803" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">23.1.Эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээтэй холбоотой санхүүжилт нь улсын төсөв, эрүүл мэндийн даатгал, реципиентийн төлөх төлбөр, хандив, тусламж, хууль тогтоомжоор хориглоогүй дэмжлэг, бусад эх үүсвэрээс бүрдэнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131492054" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">23.2.Эрхтэн, эд, эс шилжүүлэн суулгах зарим тусламж, үйлчилгээг төлбөртэй үзүүлж болно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131514728" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">23.3.Энэ хуулийн 23.2-т заасан тусламж, үйлчилгээний жагсаалт, төлбөрийн жишиг хэмжээг Эрүүл мэндийн тухай хуулийн 24.3-т заасны дагуу тогтооно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573131175174" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">23.4.Дархлаа дарангуйлах эмийн эмчилгээний санхүүжилтийг улсын төсвөөс хариуцах бөгөөд худалдан авалт, тасралтгүй бэлэн байдал, хуваарилалт, хяналтын асуудлыг Эм, эмнэлгийн хэрэгслийн тухай хуулиар зохицуулна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573132920044" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">23.5.Хүүхдэд эрхтэн, эд, эс шилжүүлэн суулгах тусламж, үйлчилгээний төлбөрийг Эрүүл мэндийн тухай хуулийн 24.6.11-д заасны дагуу шийдвэрлэнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573132212692" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">24 дүгээр зүйл.Хуулийн хэрэгжилтэд хяналт тавих</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573132912702" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">24.1.Эрхтэн, эд, эс шилжүүлэн суулгах хууль тогтоомжийн хэрэгжилтэд эрүүл мэндийн асуудал эрхэлсэн төрийн захиргааны төв байгууллага болон холбогдох бусад байгууллага хяналт тавина.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573132921516" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">25 дугаар зүйл.Хууль зөрчигчид хүлээлгэх хариуцлага</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573132293591" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">25.1.Энэ хуулийг зөрчсөн албан тушаалтны үйлдэл нь гэмт хэргийн шинжгүй бол Төрийн албаны тухай хуульд заасан хариуцлага хүлээлгэнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573132730641" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">25.2.Энэ хуулийг зөрчсөн хүн, хуулийн этгээдэд Эрүүгийн хууль, эсхүл Зөрчлийн тухай хуульд  заасан хариуцлага хүлээлгэнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1785573132770531" data-pp="0" style="position: relative; font-size: 13px; font-weight: 400; color: #000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; ">МОНГОЛ УЛСЫН ИХ ХУРЛЫН ДАРГА  С.БЯМБАЦОГТ</div></div>
</div>
</div></body>
</html>