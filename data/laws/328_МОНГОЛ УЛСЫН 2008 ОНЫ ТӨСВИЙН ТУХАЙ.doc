<tr>
<td style="width:68px;height:16px;"> <p style="text-align: justify;"> Д/д</p> </td> <td style="width:227px;height:16px;"> <p style="text-align: justify;"> Аймаг</p> </td> <td style="width:331px;height:16px;"> <p style="text-align: justify;"> Татан төвлөрүүлэх орлогын хэмжээ</p> <p style="text-align: justify;"> /сая төгрөгөөр/</p> </td> </tr>
<tr>
<td style="width:68px;height:16px;"> <p style="text-align: justify;"> 1.</p> </td> <td style="width:227px;height:16px;"> <p style="text-align: justify;"> Дорноговь</p> </td> <td style="width:198px;height:16px;"> <p style="text-align: justify;"> 1,213.1</p> </td> </tr>
