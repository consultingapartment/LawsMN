<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:doc" xmlns="http://www.w3.org/TR/REC-html40">
<head>
<!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]-->
<meta http-equiv="Content-Type" content="text/html;charset=UTF-8">
<style type="text/css">
body {
            line-height: 12px; 
            font-size: 12px; 
            color: #000; 
            -webkit-print-color-adjust: exact;
        }
@page {mso-page-border-surround-header: no;mso-page-border-surround-footer: no;}
@page Section1 {size:595.45pt 841.7pt;mso-page-orientation:portrait;margin:0.6in 0.6in 0.6in 1in;mso-header-margin:.2in;mso-footer-margin:.2in;mso-paper-source:0;} div.Section1 {page:Section1;}
a, a:visited, a:hover, a:active {
            color: #000;
            text-decoration: none; 
            cursor: default;
        } 
        a:after { content:''; } 
        a[href]:after { content: none !important; }
table {table-layout: fixed;clear: both;border-collapse: collapse;word-wrap: break-word;}
table thead th, table thead td, table tbody td, table tfoot td{overflow: hidden;word-wrap: break-word;padding: 2px 3px}
.right-rotate{mso-rotate: -90;}.left-rotate{mso-rotate: 90;}
</style>
</head>
<body><div class=Section1>
<style type="text/css">* {-webkit-box-sizing:border-box;-moz-box-sizing:border-box;box-sizing:border-box}*:before,*:after {-webkit-box-sizing:border-box;-moz-box-sizing:border-box;box-sizing:border-box}body {margin:0;padding:0;line-height:1.4em;font:12px ;color:#000;width:100%;-webkit-print-color-adjust:exact}a, a:visited, a:hover, a:active {color:inherit;text-decoration:none}a:after { content:''; }a[href]:after { content:none !important; }.navbar, .sidebar-nav {display:none}p {margin:0 0 10px}hr {margin:20px 0;border:0;border-top:1px solid #ddd;border-bottom:0;width:100%}table {table-layout:fixed;clear:both;border-collapse:collapse;page-break-after:auto;font-size:12px;border-color:grey}tr { page-break-inside:avoid; page-break-after:auto }td { page-break-inside:avoid; page-break-after:auto }thead {display:table-header-group}tbody {   display:table-row-group}tfoot {display:table-footer-group}table thead th, table thead td, table tbody td, table tfoot td {overflow:hidden;word-wrap:break-word;padding:2px 3px;line-height:12px}table thead th ul, table thead td ul, table tbody td ul, table tfoot td ul {margin-bottom:0px;padding-left:14px}table.pf-repeat-page-header thead td,table.pf-repeat-page-header thead th,table.pf-repeat-page-header tbody td,table.pf-repeat-page-header tfoot td {padding:2px 3px !important}table.pf-repeat-page-header tbody td table tbody td,table.pf-repeat-page-header tbody td table thead td,table.pf-repeat-page-header tbody td table thead th,table.pf-repeat-page-header tbody td table tfoot td {padding:2px 0 !important}table tbody td table tbody td,table tbody td table thead td,table tbody td table thead th,table tbody td table tfoot td {padding:2px 0 !important}table[border="1"] > thead > tr > td,table[border="1"] > thead > tr > th,table[border="1"] > tbody > tr > td,table[border="1"] > tbody > tr > th,table[border="1"] > tfoot > tr > td,table[border="1"] > tfoot > tr > th {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] {width:100.1% !important}td.pf-st-group-tbl,table.pf-repeat-page-header[border="1"] tbody td.pf-st-group-tbl {padding:0 !important}table.pf-repeat-page-header tbody td table[border="1"] tfoot td {padding:2px 3px !important}.pf-st-group-tbl > table[border="1"] > thead > tr > th {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] > thead > tr > td {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] > tbody > tr > td {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr > td {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr:first-child > td {  border-top:1px #fff solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr > td:first-child {  border-left:1px #fff solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr:last-child > td {  border-bottom:1px #fff solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr > td:last-child {  border-right:1px #fff solid !important}.right-rotate {-webkit-transform:rotate(90deg);-moz-transform:rotate(90deg);-ms-transform:rotate(90deg);-o-transform:rotate(90deg);transform:rotate(90deg);white-space:nowrap;word-wrap:break-word}.left-rotate {-webkit-transform:rotate(270deg);-moz-transform:rotate(270deg);-ms-transform:rotate(270deg);-o-transform:rotate(270deg);transform:rotate(270deg);white-space:nowrap;word-wrap:break-word}.right-rotate span, .left-rotate span {display:block}table.pf-report-table-none,table.pf-report-table-none td,table.pf-report-table-none th {border:0px #fff solid}table.pf-report-table-dotted,table.pf-report-table-dotted td,table.pf-report-table-dotted th {border:1px #000 dotted}table.pf-report-table-dashed,table.pf-report-table-dashed td,table.pf-report-table-dashed th {border:1px #000 dashed}table.pf-report-table-solid,table.pf-report-table-solid td,table.pf-report-table-solid th {border:1px #000 solid}table:has(thead) {min-width:100%}div.print-width-dpi {display:block;min-width:880px;height:1px} a { text-decoration: none;}  ul {padding: 0;list-style: none;} .nom-title {font-size: 11px;line-height: 22px;text-align: center;text-transform: uppercase;color: #2E3B52;max-height: 28px;overflow: hidden;margin-top: 21px;} .nom-header-top .title {font-weight: bold;font-size: 14px;line-height: 22px;color: #2E3B52;text-transform: uppercase;margin-bottom: 0;text-align: center;}.nom-header-top span {font-weight: 700;font-size: 11px;line-height: 22px;color: #000000;}.nom-header-top span {font-weight: 700;font-size: 11px;line-height: 22px;color: #000000;}.nom-more-content .uk-accordion-title {font-weight: 700;font-size: 11px;line-height: 14px;color: #2E3B52;}.nom-more-content .uk-accordion-content p {font-size: 11px;line-height: 22px;color: rgba(46, 59, 82, 0.8);margin-bottom: 0;}.nom-bottom-author {max-width: 545px;margin-left: auto;margin-top: 70px;}.nom-bottom-author h6 {font-weight: 700;font-size: 14px;line-height: 22px;color: #000000;}.uk-flex-between {justify-content: space-between;}.uk-text-center {text-align: center;}.uk-flex {display: flex;}section, p {line-height: 22px;font-size: 14px !important;font-family: Arial, Helvetica, sans-serif !important;}.pull-left {float:left;}.w-100 {width: 100%;}.w-50 {width: 50%;}</style>
<div style="padding-right: 1.5cm ">
<div class="nom-more-divider uk-text-center" style="text-align: center"><img src="https://legalinfo.mn/storage/uploads/files/suld1.png" style="margin-top: 40px;"></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611137312" data-pp="0" style="position: relative; font-size: 15px; font-weight: 700; color: #287fe6 !important;; text-align: CENTER; "><div style="padding-left: rem; ">МОНГОЛ УЛСЫН ХУУЛЬ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611009209" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color:#275dff;width:49% !important;margin-botttom:20px:; text-align: LEFT; "><div style="padding-left: rem; ">2010 оны 11 дүгээр сарын 25-ны өдөр</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611384093" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color:#275dff;width:49% !important; text-align: right !important;margin-botttom:20px:clear:both; text-align: RIGHT; "><div style="padding-left: rem; ">Улаанбаатар хот</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611732470" data-pp="0" style="position: relative; font-size: 14px; font-weight: 700; color:#000; text-transform: uppercase; line-height: 22px;margin-top:10px;margin-bottom:10px; width: 70% !important;; margin-left: 15%;; text-align: CENTER; "><div style="padding-left: rem; ">ХҮНИЙ ХӨГЖИЛ САНГИЙН 2011 ОНЫ ТӨСВИЙН ТУХАЙ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611330795" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; ">НЭГДҮГЭЭР БҮЛЭГ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611582720" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; color:#222;width:60% !important;margin-left:20%; text-align: CENTER; "><div style="padding-left: rem; "><p>НИЙТЛЭГ ҮНДЭСЛЭЛ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611528405" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">1 дүгээр зүйл.Хуулийн зорилт</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611483285" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">1.1.Энэ хуулийн зорилт нь Хүний хөгжил санд 2011 оны төсвийн жилд төвлөрүүлэх орлого, зарцуулах хөрөнгийн хэмжээ, эрсдэлийн нөөц хөрөнгийн хэмжээ, зарцуулах эрх олгохтой холбогдсон харилцааг зохицуулахад оршино.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611657205" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">2 дугаар зүйл. Хүний хөгжил сангийн 2011 оны төсвийн тухай хууль тогтоомж</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611205451" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">2.1.Хүний хөгжил сангийн 2011 оны төсвийн тухай хууль тогтоомж нь Монгол Улсын нэгдсэн төсвийн тухай, Төсвийн тогтвортой байдлын тухай<sup>2</sup>, Хүний хөгжил сангийн тухай хууль<sup>3</sup>, энэ хууль болон эдгээртэй нийцүүлэн гаргасан хууль тогтоомжийн бусад актаас бүрдэнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611930921" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>ХОЁРДУГААР БҮЛЭГ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1640711273833925" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; color:#222;width:60% !important;margin-left:20%; text-align: CENTER; "><div style="padding-left: rem; "><p>ХҮНИЙ ХӨГЖИЛ САНГИЙН 2011 ОНЫ ТӨСВИЙН ОРЛОГО, ЭХ ҮҮСВЭР, САНГААС ЗАРЦУУЛАХ ХӨРӨНГӨ, ЭРСДЭЛИЙН НӨӨЦ ХӨРӨНГӨ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611565071" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">3 дугаар зүйл.Хүний хөгжил сангийн 2011 оны төсвийн жилийн орлогын хэмжээ, эх үүсвэрийг дор дурдсанаар баталсугай:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611161283" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">3.1.Хүний хөгжил сангийн тухай хуулийн 3.2.1-д заасан орлого 44,000.0 сая төгрөг.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611156198" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">3.2.Хүний хөгжил сангийн тухай хуулийн 3.2.2-т заасан орлого 253,841.5 сая төгрөг.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611318824" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; text-decoration: underline;color: #275dff;font-style: italic;line-height: 20px;margin-bottom:10px;font-weight: 400;text-transform: none;padding-left: 3rem;; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">/Энэ хэсэгт 2011 оны 10 дугаар сарын 28-ны өдрийн хуулиар өөрчлөлт оруулсан/</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611622208" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">3.3.Хүний хөгжил сангийн тухай хуулийн 3.2.4-т заасан эх үүсвэр 490,896.4 сая төгрөг.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611505318" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; text-decoration: underline;color: #275dff;font-style: italic;line-height: 20px;margin-bottom:10px;font-weight: 400;text-transform: none;padding-left: 3rem;; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">/Энэ хэсэгт 2011 оны 10 дугаар сарын 28-ны өдрийн хуулиар өөрчлөлт оруулсан/</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611732248" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">3.4.Эрсдэлийн нөөц хөрөнгө 0.0 төгрөг.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611099274" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">4 дүгээр зүйл.2011 оны төсвийн жилд Хүний хөгжил сангийн хөрөнгөөр санхүүжүүлэх хишиг, хувийн хэмжээг дор дурдсанаар баталсугай:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611842561" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.1.Эрүүл мэндийн даатгалын шимтгэлийн төлбөрт 16,206.1 сая төгрөг.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611224721" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; text-decoration: underline;color: #275dff;font-style: italic;line-height: 20px;margin-bottom:10px;font-weight: 400;text-transform: none;padding-left: 3rem;; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">/Энэ хэсэгт 2011 оны 10 дугаар сарын 28-ны өдрийн хуулиар өөрчлөлт оруулсан/</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611534279" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.2. Бэлэн мөнгө 721,450.0 сая төгрөг.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611235624" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; text-decoration: underline;color: #275dff;font-style: italic;line-height: 20px;margin-bottom:10px;font-weight: 400;text-transform: none;padding-left: 3rem;; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">/Энэ хэсэгт 2011 оны 10 дугаар сарын 28-ны өдрийн хуулиар өөрчлөлт оруулсан/</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611942678" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.3. Оюутны сургалтын төлбөрт 70,765.5 сая төгрөг.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611128939" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; text-decoration: underline;color: #275dff;font-style: italic;line-height: 20px;margin-bottom:10px;font-weight: 400;text-transform: none;padding-left: 3rem;; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">/Энэ хэсэгт 2011 оны 10 дугаар сарын 28-ны өдрийн хуулиар өөрчлөлт оруулсан/</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611307822" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.4.Орон сууц худалдаж авсны төлбөрт 20,000.0 сая төгрөг</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611392894" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; text-decoration: underline;color: #275dff;font-style: italic;line-height: 20px;margin-bottom:10px;font-weight: 400;text-transform: none;padding-left: 3rem;; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">/Энэ хэсгийг 2011 оны 10 дугаар сарын 28-ны өдрийн хуулиар нэмсэн/</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611285043" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>ГУРАВДУГААР БҮЛЭГ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1640711293508912" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; color:#222;width:60% !important;margin-left:20%; text-align: CENTER; "><div style="padding-left: rem; "><p>БУСАД ЗҮЙЛ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611631636" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">5 дугаар зүйл.Энэ хуулийг 2011 оны 1 дүгээр сарын 1-ний өдрөөс эхлэн дагаж мөрдөнө.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1609050611759992" data-pp="0" style="position: relative; font-size: 13px; font-weight: 400; color: #000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>МОНГОЛ УЛСЫН ИХ ХУРЛЫН ДАРГА Д.ДЭМБЭРЭЛ</p></div></div>
</div>
</div></body>
</html>