 <p style="text-align:center">0.6</p>
 </td>
 <td style="border-bottom-style:solid; border-bottom-width:0.75pt; border-left-style:solid; border-left-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; vertical-align:middle; width:138.05pt">
 <p style="text-align:center">0.2</p>
 </td>
 </tr>
<tr>
<td style="border-right-style:solid; border-right-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; height:16.6pt; vertical-align:middle; width:159.3pt">
 <p style="text-align:center">Шимтгэлийн дүн</p>
 </td>
 <td style="border-left-style:solid; border-left-width:0.75pt; border-right-style:solid; border-right-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; height:16.6pt; vertical-align:middle; width:138.05pt">
 <p style="text-align:center">10.4,11.3,12.3</p>
 </td>
