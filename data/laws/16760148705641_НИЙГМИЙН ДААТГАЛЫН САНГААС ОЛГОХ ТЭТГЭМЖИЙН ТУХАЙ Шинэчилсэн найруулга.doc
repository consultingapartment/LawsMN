<tr>
<td style="border-bottom-style:solid; border-bottom-width:0.75pt; border-right-style:solid; border-right-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; height:8.35pt; vertical-align:top; width:26.45pt">
 <p style="text-align:center">3.</p>
 </td>
