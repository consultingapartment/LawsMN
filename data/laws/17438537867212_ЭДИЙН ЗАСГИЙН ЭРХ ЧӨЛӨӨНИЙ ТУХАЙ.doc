<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:doc" xmlns="http://www.w3.org/TR/REC-html40">
<head>
<!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]-->
<meta http-equiv="Content-Type" content="text/html;charset=UTF-8">
<style type="text/css">
body {
            line-height: 12px; 
            font-size: 12px; 
            color: #000; 
            -webkit-print-color-adjust: exact;
        }
@page {mso-page-border-surround-header: no;mso-page-border-surround-footer: no;}
@page Section1 {size:595.45pt 841.7pt;mso-page-orientation:portrait;margin:0.6in 0.6in 0.6in 1in;mso-header-margin:.2in;mso-footer-margin:.2in;mso-paper-source:0;} div.Section1 {page:Section1;}
a, a:visited, a:hover, a:active {
            color: #000;
            text-decoration: none; 
            cursor: default;
        } 
        a:after { content:''; } 
        a[href]:after { content: none !important; }
table {table-layout: fixed;clear: both;border-collapse: collapse;word-wrap: break-word;}
table thead th, table thead td, table tbody td, table tfoot td{overflow: hidden;word-wrap: break-word;padding: 2px 3px}
.right-rotate{mso-rotate: -90;}.left-rotate{mso-rotate: 90;}
</style>
</head>
<body><div class=Section1>
<style type="text/css">* {-webkit-box-sizing:border-box;-moz-box-sizing:border-box;box-sizing:border-box}*:before,*:after {-webkit-box-sizing:border-box;-moz-box-sizing:border-box;box-sizing:border-box}body {margin:0;padding:0;line-height:1.4em;font:12px ;color:#000;width:100%;-webkit-print-color-adjust:exact}a, a:visited, a:hover, a:active {color:inherit;text-decoration:none}a:after { content:''; }a[href]:after { content:none !important; }.navbar, .sidebar-nav {display:none}p {margin:0 0 10px}hr {margin:20px 0;border:0;border-top:1px solid #ddd;border-bottom:0;width:100%}table {table-layout:fixed;clear:both;border-collapse:collapse;page-break-after:auto;font-size:12px;border-color:grey}tr { page-break-inside:avoid; page-break-after:auto }td { page-break-inside:avoid; page-break-after:auto }thead {display:table-header-group}tbody {   display:table-row-group}tfoot {display:table-footer-group}table thead th, table thead td, table tbody td, table tfoot td {overflow:hidden;word-wrap:break-word;padding:2px 3px;line-height:12px}table thead th ul, table thead td ul, table tbody td ul, table tfoot td ul {margin-bottom:0px;padding-left:14px}table.pf-repeat-page-header thead td,table.pf-repeat-page-header thead th,table.pf-repeat-page-header tbody td,table.pf-repeat-page-header tfoot td {padding:2px 3px !important}table.pf-repeat-page-header tbody td table tbody td,table.pf-repeat-page-header tbody td table thead td,table.pf-repeat-page-header tbody td table thead th,table.pf-repeat-page-header tbody td table tfoot td {padding:2px 0 !important}table tbody td table tbody td,table tbody td table thead td,table tbody td table thead th,table tbody td table tfoot td {padding:2px 0 !important}table[border="1"] > thead > tr > td,table[border="1"] > thead > tr > th,table[border="1"] > tbody > tr > td,table[border="1"] > tbody > tr > th,table[border="1"] > tfoot > tr > td,table[border="1"] > tfoot > tr > th {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] {width:100.1% !important}td.pf-st-group-tbl,table.pf-repeat-page-header[border="1"] tbody td.pf-st-group-tbl {padding:0 !important}table.pf-repeat-page-header tbody td table[border="1"] tfoot td {padding:2px 3px !important}.pf-st-group-tbl > table[border="1"] > thead > tr > th {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] > thead > tr > td {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] > tbody > tr > td {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr > td {border:1px #777 solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr:first-child > td {  border-top:1px #fff solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr > td:first-child {  border-left:1px #fff solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr:last-child > td {  border-bottom:1px #fff solid !important}.pf-st-group-tbl > table[border="1"] > tfoot > tr > td:last-child {  border-right:1px #fff solid !important}.right-rotate {-webkit-transform:rotate(90deg);-moz-transform:rotate(90deg);-ms-transform:rotate(90deg);-o-transform:rotate(90deg);transform:rotate(90deg);white-space:nowrap;word-wrap:break-word}.left-rotate {-webkit-transform:rotate(270deg);-moz-transform:rotate(270deg);-ms-transform:rotate(270deg);-o-transform:rotate(270deg);transform:rotate(270deg);white-space:nowrap;word-wrap:break-word}.right-rotate span, .left-rotate span {display:block}table.pf-report-table-none,table.pf-report-table-none td,table.pf-report-table-none th {border:0px #fff solid}table.pf-report-table-dotted,table.pf-report-table-dotted td,table.pf-report-table-dotted th {border:1px #000 dotted}table.pf-report-table-dashed,table.pf-report-table-dashed td,table.pf-report-table-dashed th {border:1px #000 dashed}table.pf-report-table-solid,table.pf-report-table-solid td,table.pf-report-table-solid th {border:1px #000 solid}table:has(thead) {min-width:100%}div.print-width-dpi {display:block;min-width:880px;height:1px} a { text-decoration: none;}  ul {padding: 0;list-style: none;} .nom-title {font-size: 11px;line-height: 22px;text-align: center;text-transform: uppercase;color: #2E3B52;max-height: 28px;overflow: hidden;margin-top: 21px;} .nom-header-top .title {font-weight: bold;font-size: 14px;line-height: 22px;color: #2E3B52;text-transform: uppercase;margin-bottom: 0;text-align: center;}.nom-header-top span {font-weight: 700;font-size: 11px;line-height: 22px;color: #000000;}.nom-header-top span {font-weight: 700;font-size: 11px;line-height: 22px;color: #000000;}.nom-more-content .uk-accordion-title {font-weight: 700;font-size: 11px;line-height: 14px;color: #2E3B52;}.nom-more-content .uk-accordion-content p {font-size: 11px;line-height: 22px;color: rgba(46, 59, 82, 0.8);margin-bottom: 0;}.nom-bottom-author {max-width: 545px;margin-left: auto;margin-top: 70px;}.nom-bottom-author h6 {font-weight: 700;font-size: 14px;line-height: 22px;color: #000000;}.uk-flex-between {justify-content: space-between;}.uk-text-center {text-align: center;}.uk-flex {display: flex;}section, p {line-height: 22px;font-size: 14px !important;font-family: Arial, Helvetica, sans-serif !important;}.pull-left {float:left;}.w-100 {width: 100%;}.w-50 {width: 50%;}</style>
<div style="padding-right: 1.5cm ">
<div class="nom-more-divider uk-text-center" style="text-align: center"><img src="https://legalinfo.mn/storage/uploads/files/suld1.png" style="margin-top: 40px;"></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497666882" data-pp="0" style="position: relative; font-size: 15px; font-weight: 700; color: #287fe6 !important;; text-align: CENTER; "><div style="padding-left: rem; ">МОНГОЛ УЛСЫН ХУУЛЬ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497749236" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color:#275dff;width:49% !important;margin-botttom:20px:; text-align: LEFT; "><div style="padding-left: rem; ">2026 оны 07 сарын 03 өдөр</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497301194" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color:#275dff;width:49% !important; text-align: right !important;margin-botttom:20px:clear:both; text-align: RIGHT; "><div style="padding-left: rem; ">Төрийн ордон, Улаанбаатар хот</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497737951" data-pp="0" style="position: relative; font-size: 14px; font-weight: 700; color:#000; text-transform: uppercase; line-height: 22px;margin-top:10px;margin-bottom:10px; width: 70% !important;; margin-left: 15%;; text-align: CENTER; "><div style="padding-left: rem; ">ЭДИЙН ЗАСГИЙН ЭРХ ЧӨЛӨӨНИЙ ТУХАЙ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497994721" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; ">НЭГДҮГЭЭР БҮЛЭГ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497366910" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>НИЙТЛЭГ ҮНДЭСЛЭЛ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497321319" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">1 дүгээр зүйл.Хуулийн зорилт</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497117471" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">1.1.Энэ хуулийн зорилт нь Монгол Улсын Үндсэн хуульд заасан өмчлөгчийн эрхийг хамгаалах, бизнесийн үйл ажиллагааг чөлөөтэй эрхлэх эрх, эдийн засгийн эрх чөлөөг баталгаажуулах, шударга өрсөлдөөн, бизнесийн орчны тогтвортой байдлыг хангахтай холбогдсон харилцааг зохицуулахад оршино.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497277978" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">2 дугаар зүйл.Эдийн засгийн эрх чөлөөний хууль тогтоомж</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497292840" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">2.1.Эдийн засгийн эрх чөлөөний хууль тогтоомж нь Монгол Улсын Үндсэн хууль<sup>[1]</sup>, энэ хууль болон эдгээр хуультай нийцүүлэн гаргасан хууль тогтоомжийн бусад актаас бүрдэнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497304659" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">2.2.Монгол Улсын олон улсын гэрээнд энэ хуульд зааснаас өөрөөр заасан бол олон улсын гэрээний заалтыг дагаж мөрдөнө.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497501530" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">3 дугаар зүйл.Эдийн засгийн эрх чөлөөг хангахад баримтлах зарчим</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497906264" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">3.1.Эдийн засгийн эрх чөлөөг хангахад дараах зарчмыг баримтална:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497124497" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.1.хуулиар хориглосноос бусад бизнесийн үйл ажиллагааг чөлөөтэй эрхлэх нөхцөлийг бүрдүүлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497493283" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.2.бизнесийн үйл ажиллагаанд хийх хязгаарлалт нь зорилгодоо хүрэхэд тохирсон, боломжит хамгийн бага түвшинд байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497748077" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.3.төрийн зохицуулалт нь тогтвортой, урьдчилан таамаглах боломжтой байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497551439" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.4.шударгаар олж авсан өмчлөх эрхийг хамгаалах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497105653" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.5.бизнесийн үйл ажиллагаанд хамаарах мэдээллийг хуульд заасан үндэслэл, журмын дагуу цуглуулах, боловсруулах, ашиглах, хуульд зааснаас бусад тохиолдолд задруулахгүй байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497188527" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; "><p>3.1.6.хөдөлмөр, оюуны бүтээл, хөрөнгө оруулалтын үр шимээр болон хууль ёсны дагуу олсон орлогоо чөлөөтэй эзэмших, ашиглах, захиран зарцуулах эрхийг баталгаажуулах;</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497804610" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.7.хуулийн хүрээнд гэрээг чөлөөтэй байгуулах, түүний агуулгыг бие даан тодорхойлох эрхийг хангах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497779132" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.8.хөдөлмөрлөх эрхийг бүрэн хангах, зохистой хөдөлмөрийг дэмжих;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497518754" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.9.ажиллах хүчний шилжилт хөдөлгөөний бодлого, зохицуулалтыг хөдөлмөрийн зах зээлийн эрэлт, нийлүүлэлттэй уялдуулах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497440628" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.10.шударга өрсөлдөөнийг үндэслэлгүйгээр хязгаарлахгүй байх, өмчийн хэлбэр харгалзахгүйгээр шударгаар өрсөлдөх боломжоор хангах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497601373" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.11.хуульд зааснаас бусад тохиолдолд төрийн болон орон нутгийн өмчит компани байгуулахгүй байх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497323784" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.12.төрийн үйлчилгээ цахим, ил тод, түргэн шуурхай, тэгш хүртээмжтэй байх, бизнес эрхлэгчээс нэг мэдээллийг нэг удаа авах нөхцөлийг бүрдүүлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497582800" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.13.нийтийн мэдээллийг хуульд заасны дагуу нээлттэй өгөгдөл болгож ашиглах боломжийг нэмэгдүүлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497555273" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.14.бизнесийн үйл ажиллагаанд эрсдэлийн үнэлгээнд суурилсан, давхардалгүй, ил тод, эрсдэлээс урьдчилан сэргийлэх, зөвлөн туслахад чиглэсэн хяналт шалгалтыг тэргүүн ээлжид хэрэгжүүлэх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497920911" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">3.1.15.хуульд зааснаас бусад тохиолдолд төрөөс үнэ тогтоох үйл ажиллагаанд аливаа хэлбэрээр оролцохгүй байх.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497692928" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">3.2.Эдийн засгийн харилцааг зохицуулсан хууль тогтоомжийн төслийг боловсруулах, хэлэлцэн батлахдаа энэ хуулийн 3.1-д заасан зарчмыг баримтална.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497630442" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; ">ХОЁРДУГААР БҮЛЭГ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497087419" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>ЭДИЙН ЗАСГИЙН ЭРХ ЧӨЛӨӨГ ХАНГАХ ҮЙЛ АЖИЛЛАГАА</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497488495" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">4 дүгээр зүйл.Эдийн засгийн эрх чөлөөг хангах төрийн бодлого, зохицуулалт</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497523284" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.1.Төрийн байгууллага, албан тушаалтан бизнесийн үйл ажиллагаанд хийх төрийн зохицуулалтыг боловсруулахдаа бизнес эрхлэгчид үзүүлэх ачаалал, шударга өрсөлдөөний хязгаарлалт, хөрөнгө оруулалтын орчинд үзүүлэх нөлөөллийг үнэлж, бизнес эрхлэгч болон мэргэжлийн холбоо, иргэний нийгмийн байгууллага, олон нийтийн оролцоог хангаж ажиллана.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497508231" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.2.Өмчлөх эрхийг хязгаарлах шийдвэр, үйл ажиллагаа нь Монгол Улсын Үндсэн хуулийн Тавдугаар зүйлийн 3 дахь хэсэгт заасны дагуу хуулиар эрх олгосон байх шаардлагыг хангасан байна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497579213" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.3.Төрөөс үнэ тогтоох, нийлүүлэлтийг хязгаарлах шийдвэр гаргахдаа энэ хуулийн 3.1.2-т заасан зарчмыг баримтлах бөгөөд аливаа хязгаарлалтыг зөвхөн тодорхой хугацаагаар тогтооно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497180980" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.4.Тухайн жилийн төсвийн тухай хууль, түүнийг дагаж боловсруулсан хууль тогтоомжоос бусад хууль тогтоомж нь бизнес эрхлэгчийн ашигт ажиллагаанд сөргөөр нөлөөлөх, зардлыг нэмэгдүүлэхээр байгаа бол түүний хүчин төгөлдөр болох хугацааг баталснаас хойш 6-аас доошгүй сарын дараа дагаж мөрдөхөөр тогтооно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497998346" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.5.Бизнесийн үйл ажиллагааг зохицуулж байгаа хууль тогтоомж, захиргааны шийдвэрийн үр дагаварт жил тутам шинжилгээ хийж шаардлагагүй, давхардсан, үр ашиггүй зохицуулалтыг багасгах арга хэмжээ авна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497148683" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.6.Бизнес эрхлэгчийн ашиг, орлого, хөрөнгөд ногдуулах татварыг зөвхөн хуулиар тогтооно.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497124172" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.7.Төр нь бизнесийн үйл ажиллагаанаас үүссэн маргааныг эвлэрүүлэн зуучлал, арбитрын болон бусад шүүхийн бус журмаар шуурхай, шударга, хараат бусаар шийдвэрлэх боломжийг дэмжинэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497850891" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.8.Төрийн аливаа сонгон шалгаруулах үйл ажиллагаа, төсвийн болон төсвийн бус хөрөнгийн захиран зарцуулалт, худалдан авалт нь бизнес эрхлэгчийн зах зээлд чөлөөтэй, шударга өрсөлдөх боломж, нөхцөлийг хангасан байна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497275309" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.9.Мэргэжил эзэмших, дээд болон мэргэжлийн боловсрол, сургалт, ажиллах хүчний шилжилт хөдөлгөөнийг хөдөлмөрийн зах зээл, эдийн засгийн эрэлт, хэрэгцээнд нийцүүлэн зохицуулна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497351073" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.10.Төсвийн сахилга батыг сахиж, Төсвийн тогтвортой байдлын тухай хуульд<sup>[2]</sup> заасан төсвийн тусгай шаардлагыг хангаж ажиллана.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497765317" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">4.11.Төр нь бизнес эрхлэгчийн зөвшөөрөлтэй эрхэлж байгаа үйл ажиллагааг хэвийн, саадгүй явуулах нөхцөлийг бүрдүүлнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497461894" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; ">ГУРАВДУГААР БҮЛЭГ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497189789" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>ГОМДОЛ ГАРГАХ, ИЛ ТОД БАЙДАЛ, ХЯНАЛТ</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497280276" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">5 дугаар зүйл.Гомдол гаргах эрх</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497812133" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">5.1.Бизнес эрхлэгч төрийн хууль бус шийдвэр, үйл ажиллагаанд гомдол гаргах эрхтэй бөгөөд төрийн байгууллага, албан тушаалтан гомдлыг хуульд заасан хугацаанд шуурхай шийдвэрлэх, түүний зөрчигдсөн эрхийг сэргээх, бизнес эрхлэгчид учирсан хохирлыг хуульд заасны дагуу нөхөн төлөх үүрэгтэй.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497832819" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">6 дугаар зүйл.Ил тод байдал, хяналт</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497712781" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">6.1.Төрийн байгууллага, албан тушаалтан бизнесийн үйл ажиллагаанд дагаж мөрдөж байгаа төрийн зохицуулалтын үндэслэл, зорилго, үр нөлөө, шийдвэр гаргах үйл явцын талаарх мэдээллийг нийтэд ил тод мэдээлж байна.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497243489" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">6.2.Төр бизнесийн үйл ажиллагаатай холбоотой өөрт байгаа мэдээллийг нийтэд тэгш, шударга, хүртээмжтэйгээр хүргэнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497302174" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">6.3.Засгийн газар эдийн засгийн эрх чөлөөг хангах тухай энэ хуулийн хэрэгжилтийн тайланг жил бүр Улсын Их Хуралд танилцуулж, хэлэлцүүлнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497346256" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">6.4.Тайланд дараах мэдээллийг тусгана:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497217381" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">6.4.1.эдийн засгийн зохицуулалт хийсэн хүрээ, арга хэлбэр, үр нөлөөний тоон үзүүлэлт;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497732747" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">6.4.2.эдийн засгийн эрх чөлөө зөрчигдсөн, нөхөн төлбөр олгосон тохиолдлын тоо, хэмжээ;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497042609" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">6.4.3.ил тод байдал, шударга өрсөлдөөний орчны талаарх дүн шинжилгээ;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497573440" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">6.4.4.үнэ тарифын зохицуулалттай бизнесийн үйл ажиллагааны жагсаалт, тэдгээрт төрөөс олгосон татаас, дэмжлэгийн хэмжээ, эдийн засаг, нийгэмд үзүүлэх нөлөөлөл, үнэ тарифын зохицуулалтын үргэлжлэх хугацаа;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497737960" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">6.4.5.энэ хуулийн 6.4.4-т зааснаас бусад төрөөс бизнесийн үйл ажиллагаанд олгосон татаас, дэмжлэгийн хэмжээ;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497601425" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">6.4.6.эдийн засгийн эрх чөлөөний төлөв байдлын талаарх хөндлөнгийн мэргэжлийн байгууллагын санал.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497826501" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">7 дугаар зүйл.Төрийн бодлого, үйл ажиллагаанд хориглох зүйл</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497501640" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">7.1.Эдийн засгийн эрх чөлөөг хангах төрийн бодлого, үйл ажиллагаанд дараах зүйлийг хориглоно:</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497052377" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">7.1.1.үндэсний аюулгүй байдал, иргэний үндсэн эрх, эрх чөлөө, хүн амын эрүүл мэнд, байгаль орчныг хамгаалах зорилгоор нийтийн ашиг сонирхол, шударга өрсөлдөөнийг хамгаалахаас бусад тохиолдолд эдийн засгийн эрх чөлөөг хязгаарласан, хориглосон хууль тогтоомж, захиргааны хэм хэмжээний акт, дүрэм, журам, норм, стандартын баримт бичиг батлан гаргах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497161442" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">7.1.2.бизнес эрхлэгчийн ажил хэргийн нэр хүндэд халдах, үндэслэлгүй, хуурамч мэдээлэл түгээх;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497339780" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">7.1.3.бизнес эрхлэгчийг нийгмийн хариуцлагын үйл ажиллагаанд албадан татан оролцуулах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497534548" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">7.1.4.хуульд зааснаас бусад тохиолдолд зарим бизнес эрхлэгчид давуу эрх олгосон захиргааны хэм хэмжээний акт, дүрэм, журам батлах, үйл ажиллагаа явуулах, эс үйлдэхүй гаргах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497741520" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">7.1.5.энэ хуульд заасан зарчмыг зөрчиж эдийн засгийн эрх чөлөөг хязгаарласан хууль тогтоомж, захиргааны хэм хэмжээний акт батлах, эс үйлдэхүй гаргах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497588667" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">7.1.6.бизнесийн үйл ажиллагаанд зүй бусаар нөлөөлөх, оролцох, өмч хөрөнгийг нь хууль бусаар хураан авах, дайчлах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497820567" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">7.1.7.бизнес эрхлэгчид төрийн үйлчилгээ үзүүлэхдээ хууль, захиргааны хэм хэмжээний актад зааснаас бусад баримт бичиг, түүний бүрдлийг шаардах;</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497181466" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333;line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 4rem; ">7.1.8.бизнес эрхлэгчийн үйл ажиллагаанд хуульд заагаагүй хяналт шалгалт хийх, хяналт шалгалт хийхээр тогтоосон хугацааг хэтрүүлэх.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497249061" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">7.2.Хувийн өмчийг нийгмийн зайлшгүй хэрэгцээг үндэслэн хураах, дайчлан авах төрийн шийдвэр нь зөвхөн зах зээлийн бодит үнэлгээнд үндэслэсэн нөхөх олговор бүрэн төлөгдсөн тохиолдолд хэрэгжинэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497782133" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; ">ДӨРӨВДҮГЭЭР БҮЛЭГ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497419682" data-pp="2" style="position: relative; font-size: 13px; font-weight: 700; text-transform:uppercase;color:#000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; "><p>БУСАД</p></div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475497572882" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; "><div style="padding-left: rem; ">8 дугаар зүйл.Хууль зөрчигчид хүлээлгэх хариуцлага</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475498853423" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">8.1.Энэ хуулийг зөрчсөн төрийн албан тушаалтны үйлдэл нь гэмт хэргийн шинжгүй бол Төрийн албаны тухай хуульд<sup>[3]</sup> заасан хариуцлага хүлээлгэнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475498345058" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">8.2.Энэ хуулийг зөрчсөн хүн, хуулийн этгээдэд Эрүүгийн хууль<sup>[4]</sup>, эсхүл Зөрчлийн тухай хуульд<sup>[5]</sup> заасан хариуцлага хүлээлгэнэ.</div></div>
<div class="w-100 pull-left " data-parentid="" id="1787475498223104" data-pp="0" style="position: relative; font-size: 13px; font-weight: 400; color: #000;margin-top:20px; text-align: CENTER; "><div style="padding-left: rem; ">МОНГОЛ УЛСЫН ИХ ХУРЛЫН ДАРГА С.БЯМБАЦОГТ</div></div>
</div>
</div></body>
</html>