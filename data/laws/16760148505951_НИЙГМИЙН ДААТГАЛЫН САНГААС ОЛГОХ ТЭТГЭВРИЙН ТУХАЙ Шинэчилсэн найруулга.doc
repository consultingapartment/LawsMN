<td style="border-bottom-style:solid; border-bottom-width:0.75pt; border-right-style:solid; border-right-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; vertical-align:top; width:225pt">
 <p style="text-align:center">2</p>
 </td>
 <td style="border-bottom-style:solid; border-bottom-width:0.75pt; border-left-style:solid; border-left-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; vertical-align:top; width:285px">
 <p style="text-align:center">75</p>
 </td>
 </tr>
<tr>
<td style="border-right-style:solid; border-right-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; vertical-align:top; width:225pt">
 <p style="text-align:center">1</p>
 </td>
 <td style="border-left-style:solid; border-left-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; vertical-align:top; width:285px">
 <p style="text-align:center">50</p>
 </td>
