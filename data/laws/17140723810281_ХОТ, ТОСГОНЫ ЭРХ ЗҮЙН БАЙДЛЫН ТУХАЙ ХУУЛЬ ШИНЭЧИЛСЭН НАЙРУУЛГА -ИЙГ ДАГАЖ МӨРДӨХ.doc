px} a { text-decoration: none;}  ul {padding: 0;list-style: none;} .nom-title {font-size: 11px;line-height: 22px;text-align: center;text-transform: uppercase;color: #2E3B52;max-height: 28px;overflow: hidden;margin-top: 21px;} .nom-header-top .title {font-weight: bold;font-size: 14px;line-height: 22px;color: #2E3B52;text-transform: uppercase;margin-bottom: 0;text-align: center;}.nom-header-top span {font-weight: 700;font-size: 11px;line-height: 22px;color: #000000;}.nom-header-top span {font-weight: 700;font-size: 11px;line-height: 22px;color: #000000;}.nom-more-content .uk-accordion-title {font-weight: 700;font-size: 11px;line-height: 14px;color: #2E3B52;}.nom-more-content .uk-accordion-content p {font-size: 11px;line-height: 22px;color: rgba(46, 59, 82, 0.8);margin-bottom: 0;}.nom-bottom-author {max-width: 545px;margin-left: auto;margin-top: 70px;}.nom-bottom-author h6 {font-weight: 700;font-size: 14px;line-height: 22px;color: #000000;}.uk-flex-between {justify-content: space-between;}.uk-text-center {text-align: center;}.uk-flex {display: flex;}section, p {line-height: 22px;font-size: 14px !important;font-family: Arial, Helvetica, sans-serif !important;}.pull-left {float:left;}.w-100 {width: 100%;}.w-50 {width: 50%;}</style>
<div style="padding-right: 1.5cm ">
<div class="nom-more-divider uk-text-center" style="text-align: center"><img src="https://legalinfo.mn/storage/uploads/files/suld1.png" style="margin-top: 40px;"></div>
<div class="w-100 pull-left " data-parentid="" id="1719292262863250" data-pp="0" style="position: relative; font-size: 15px; font-weight: 700; color: #287fe6 !important;; text-align: CENTER; "><div style="padding-left: rem; ">МОНГОЛ УЛСЫН ХУУЛЬ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1719292262890313" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color:#275dff;width:49% !important;margin-botttom:20px:; text-align: LEFT; "><div style="padding-left: rem; ">2024 оны 06 сарын 05 өдөр</div></div>
<div class="w-100 pull-left " data-parentid="" id="1719292262195238" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color:#275dff;width:49% !important; text-align: right !important;margin-botttom:20px:clear:both; text-align: RIGHT; "><div style="padding-left: rem; ">Төрийн ордон, Улаанбаатар хот</div></div>
<div class="w-100 pull-left " data-parentid="" id="1719292262563346" data-pp="0" style="position: relative; font-size: 14px; font-weight: 700; color:#000; text-transform: uppercase; line-height: 22px;margin-top:10px;margin-bottom:10px; width: 70% !important;; margin-left: 15%;; text-align: CENTER; "><div style="padding-left: rem; ">ХОТ, ТОСГОНЫ ЭРХ ЗҮЙН БАЙДЛЫН ТУХАЙ ХУУЛЬ /ШИНЭЧИЛСЭН НАЙРУУЛГА/-ИЙГ ДАГАЖ МӨРДӨХ ЖУРМЫН ТУХАЙ</div></div>
<div class="w-100 pull-left " data-parentid="" id="1719292262116838" data-pp="1" style="position: relative; font-size: 13px; font-weight: 700; color: #293E9C;margin-top:20px;; text-align: JUSTIFY; ">
<div style="padding-left: rem; "><p>1 дүгээр зүйл.Аймаг, нийслэл, сум, дүүргийн иргэдийн Төлөөлөгчдийн Хурлын 2024 оны сонгуулийн үр дүнгээр байгуулагдсан аймаг, сум, дүүргийн иргэдийн Төлөөлөгчдийн Хурлын төлөөлөгч, тэдгээрээс нэр дэвшүүлж томилогдсон Засаг дарга нь 2027 оны 01 дүгээр сарын 01-ний өдрөөс эхлэн хотын Зөвлөл, Захирагч хуулийн дагуу сонгогдох хүртэл харьяалах хотын Зөвлөл, Захирагчийн хуулиар хүлээсэн чиг үүргийг дараах байдлаар хэрэгжүүлнэ:<br>
 </p></div>
<p style="   padding-left: rem; margin: 0;position: relative; font-size: 13px; font-weight: ; text-decoration: underline;     color: #275dff;font-style: italic;; text-align: JUSTIFY; ">/Энэ зүйлд 2025 оны 05 дугаар сарын 26-ны өдрийн хуулиар өөрчлөлт оруулсан./</p>
</div>
<div class="w-100 pull-left " data-parentid="" id="1719292262223088" data-pp="0" style="position: relative; font-size: 13px; font-weight: 400; color:#333;; text-align: JUSTIFY; ">
<div style="padding-left: rem; ">
<table cellpadding="0" cellspacing="0" style="border-collapse:collapse; width:475.3pt"></table>
<table cellpadding="0" cellspacing="0" style="border-collapse:collapse; width:475.3pt"><tbody>
<tr>
<td style="border-style:solid; border-width:0.75pt; vertical-align:top; width:17.9pt">
 <p style="text-align:justify"> </p>

 <p style="text-align:justify">Д/д</p>
 </td>
 <td style="border-style:solid; border-width:0.75pt; vertical-align:middle; width:102.9pt">
 <p style="text-align:center">Хотын нэр</p>
 </td>
 <td style="border-style:solid; border-width:0.75pt; vertical-align:top; width:173.6pt">
 <p style="text-align:center">Хотын Зөвлөл, Захирагчийн чиг үүргийг хэрэгжүүлэх засаг захиргаа, нутаг дэвсгэрийн нэгжийн удирдлага</p>
 </td>
 <td style="border-style:solid; border-width:0.75pt; vertical-align:middle; width:136.95pt">
 <p style="text-align:center">Хотын удирдлага</p>
 </td>
 </tr>
<tr>
<td colspan="4" style="border-style:solid; border-width:0.75pt; height:17pt; vertical-align:middle; width:463.75pt">
 <p style="text-align:center">Нэг.Улсын зэрэглэлтэй хот</p>
 </td>
 </tr>
<tr>
<td rowspan="2" style="border-style:solid; border-width:0.75pt; vertical-align:middle; width:17.9pt">
 <p> </p>

 <p>1</p>
 </td>
 <td rowspan="2" style="border-style:solid; border-width:0.75pt; vertical-align:middle; width:102.9pt">
 <p style="text-align:center">Дархан хот</p>
 </td>
 <td style="border-style:solid; border-width:0.75pt; vertical-align:middle; width:173.6pt">
 <p>Дархан-Уул аймгийн иргэдийн Төлөөлөгчдийн Хурал</p>
 </td>
 <td style="border-style:solid; border-width:0.75pt; vertical-align:middle; width:136.95pt">
 <p>Дархан хотын Зөвлөл</p>
 </td>
 </tr>
<tr>
<td style="border-style:solid; border-width:0.75pt; vertical-align:middle; width:173.6pt">
 <p>Дархан-Уул аймгийн Засаг дарга</p>
 </td>
 <td style="border-style:solid; border-width:0.75pt; vertical-align:middle; width:136.95pt">
 <p>Дархан хотын Захирагч</p>
