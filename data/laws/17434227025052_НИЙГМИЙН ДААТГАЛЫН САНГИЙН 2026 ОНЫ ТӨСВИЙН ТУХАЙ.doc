<tr>
<td colspan="3" style="border-right-style:solid; border-right-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; height:15pt; vertical-align:bottom; width:331.2pt">
 <p style="text-align:center">Нийт орлого</p>
 </td>
 <td style="border-top-style:solid; border-top-width:0.75pt; height:15pt; vertical-align:middle; width:98.9pt">
