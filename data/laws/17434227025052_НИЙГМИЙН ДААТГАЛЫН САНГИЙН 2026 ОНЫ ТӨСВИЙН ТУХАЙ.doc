<tr>
<td style="border-bottom-style:solid; border-bottom-width:0.75pt; border-right-style:solid; border-right-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; height:15.75pt; vertical-align:middle; width:33.15pt">
 <p style="text-indent:12pt">1.3</p>
 </td>
 <td style="border-style:solid; border-width:0.75pt; height:15.75pt; vertical-align:bottom; width:253.95pt">
 <p style="text-align:justify">Эхийн хүүхэд асрах чөлөөтэй хугацааны шимтгэл</p>
 </td>
 <td style="border-bottom-style:solid; border-bottom-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; height:15.75pt; vertical-align:middle; width:98.9pt">
