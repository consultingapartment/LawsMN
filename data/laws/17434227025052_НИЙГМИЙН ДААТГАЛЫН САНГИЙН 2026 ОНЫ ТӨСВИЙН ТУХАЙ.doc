<tr>
<td style="border-bottom-style:solid; border-bottom-width:0.75pt; border-right-style:solid; border-right-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; height:28.5pt; vertical-align:middle; width:33.15pt">
 <p style="text-indent:12pt">1.7</p>

 <p style="text-indent:12pt"> </p>
 </td>
 <td style="border-style:solid; border-width:0.75pt; height:28.5pt; vertical-align:top; width:253.95pt">
 <p style="text-align:justify">Үйлдвэрлэлийн осол, мэргэжлээс шалтгаалах өвчний улмаас хөгжлийн бэрхшээлтэй болсон даатгуулагчийн төлөх шимтгэл</p>
 </td>
 <td style="border-bottom-style:solid; border-bottom-width:0.75pt; border-top-style:solid; border-top-width:0.75pt; height:28.5pt; vertical-align:middle; width:98.9pt">
