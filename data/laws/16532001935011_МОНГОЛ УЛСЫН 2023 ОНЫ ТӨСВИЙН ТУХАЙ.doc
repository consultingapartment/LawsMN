 <td style="border-bottom:1px solid black; border-left:none; border-right:1px solid black; border-top:1px solid black; height:34px; width:40%"><span style="font-size:11pt"><span style="font-family:Calibri,sans-serif"><strong><span style="font-family:" arial><span style="color:black">Аймаг</span></span></strong></span></span></td>
 <td style="border-bottom:1px solid black; border-left:none; border-right:1px solid black; border-top:1px solid black; height:34px; width:52%">
