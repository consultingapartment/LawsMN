<td style="width:207px;"> <p> Өвөрхангай</p> </td> <td style="width:123px;"> <p align="right"> 1 996 919.4</p> </td> </tr>
<tr>
<td style="width:207px;"> <p> Өмнөговь</p> </td> <td style="width:123px;"> <p align="right"> 1 792 042.5</p> </td> </tr>
<tr>
<td style="width:207px;"> <p> Сүхбаатар</p> </td> <td style="width:123px;"> <p align="right"> 2 184 529.5</p> </td> </tr>
