<div class="w-100 pull-left " data-parentid="" id="1615521277736712" data-pp="0" style="position: relative; font-size: 13px; font-weight: ; color: #333; line-height: 20px; margin-top:10px; text-align: JUSTIFY; "><div style="padding-left: 3rem; ">/мянган төгрөг/</div></div>
